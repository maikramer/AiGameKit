# Screenshots / QA / capturas de debug na raiz do monorepo.
# Regra genérica: QUALQUER imagem solta na raiz é ignorada — screenshots de
# QA nunca pertencem ao repo. Assets legítimos vivem em subdirs (assets/,
# public/, examples/, etc.). Adicionar exceções aqui só se for mesmo necessário.
/*.png
/*.jpeg
/*.jpg
/*.gif
/*.webp
/*.bmp

# Agent tool artifacts
.sisyphus/
.playwright-mcp/

# Backup de .git antes de reescrita de histórico (BFG / filter-repo)
.git.bak-pre-bfg*/

# Cursor — estado local dos hooks (não versionar)
.cursor/hooks/

# VibeGame simple-rpg — saída intermédia do batch (duplica models/textures)
VibeGame/examples/simple-rpg/public/assets/meshes/
VibeGame/examples/simple-rpg/public/assets/images/
# Marker written by scripts/fetch-assets.mjs (prebuilt asset bundle version)
VibeGame/examples/simple-rpg/public/assets/.assets-version

# Screenshots de teste no exemplo
VibeGame/examples/simple-rpg/screenshot*.png

# Backups locais (.bak)
*.bak.*
*.bak

# Libs de terceiros copiadas para public (basis transcoder, etc.)
VibeGame/examples/simple-rpg/public/libs/

# Screenshots de teste na raiz do VibeGame
VibeGame/*test*.png
VibeGame/screenshot*.png

# OpenCode agent workspace (local state, plans, evidence, notepads)
.omo/

# GameAssets debug_minimal — assets gerados localmente por `gameassets batch`.
# Os .yaml de configuração estão versionados como fixtures; os outputs (PNGs,
# JSONs de metadados, heightmaps) regeneram-se e não pertencem ao repo.
GameAssets/debug_minimal/images/
GameAssets/debug_minimal/sky/
GameAssets/debug_minimal/terrain/

# Backup de assets regenerados (ex.: bgm_*.orig.ogg antes do seamless-loop)
*.orig.ogg
*.orig.*

# Graphify knowledge graph (artefacto local de análise de codebase)
graphify-out/

# ZCode agent workspace (estado local da sessão)
.zcode/
