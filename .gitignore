# JSONs de metadados, heightmaps) regeneram-se e não pertencem ao repo.
GameAssets/debug_minimal/images/
GameAssets/debug_minimal/sky/
GameAssets/debug_minimal/terrain/

# Backup de assets regenerados (ex.: bgm_*.orig.ogg antes do seamless-loop)
*.orig.ogg
*.orig.*

# Graphify knowledge graph (artefacto local de análise de codebase)
graphify-out/

# ZCode agent workspace (estado local da sessão)
.zcode/

