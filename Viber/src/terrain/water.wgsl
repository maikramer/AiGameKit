// Viber water — animated lake/river surface with depth-based volume, on top
// of the full PBR stack.
//
// The fragment entry REPLACES `StandardMaterial`'s (ExtendedMaterial base):
// it rebuilds `PbrInput` via `pbr_input_from_standard_material`, perturbs the
// normal with a wind-driven wave field, and — the part that makes water read
// as a *body* instead of a sheet of cellophane — reads the water column from
// the PER-VERTEX depth baked by `water.rs` (uv.y = water_y − leito da grid
// do carve) and applies Beer–Lambert absorption over it. A coluna é
// ANALÍTICA: não depende do LOD do terreno nem do depth prepass — as
// leituras do prepass mudavam nas fronteiras de chunk e desenhavam faixas no
// corpo (e o fallback de coluna constante ao lado de leituras reais era
// outra faixa). Shallow water is clear, deep water is near-opaque, and the
// shoreline gets a foam band for free. Lighting, shadows and fog still come
// from the normal PBR path.
//
// MESH CONTRACT (see `water.rs`): vertex COLOR = body rgb + shore-fade mask
// in alpha; vertex UV.x = the body's `opacity` reinterpreted as an
// **extinction scale** (how murky the water is), UV.y = water depth in
// meters. No texture is sampled, so the UVs are free for this.
//
// WORLD SPECIALIZATION: `viber run` rewrites the CONFIG block below from the
// world's <DayCycle>/<Weather> attributes before the renderer loads this file
// (mirror of shaders/sky.wgsl — NO material uniform: the Bevy 0.19 slot-1
// storage promotion never re-uploads modified uniforms). Per-frame values
// come from `Globals` (engine-updated view binding).

#import bevy_pbr::forward_io::{Vertex, VertexOutput, FragmentOutput}
#import bevy_pbr::pbr_fragment::pbr_input_from_standard_material
#import bevy_pbr::pbr_functions::{alpha_discard, apply_pbr_lighting, main_pass_post_lighting_processing}
// O `globals`/`view` chegam pelo mesh_view_bindings (o pbr_fragment importa-o)
// — redeclarar em group(0) conflitua com o binding da view.
#import bevy_pbr::mesh_view_bindings::{globals, view}
#import bevy_pbr::view_transformations as vt
// O vertex shader da extensão SUBSTITUI o base do bevy (extended_material),
// por isso este ficheiro replica o `mesh.wgsl` inteiro e importa o mesmo
// conjunto de módulos (linhas simples — o harness de testes resolve-as).
#import bevy_pbr::mesh_functions
#import bevy_pbr::skinning
#import bevy_pbr::morph::{morph_position, morph_normal, morph_tangent}

// === WORLD CONFIG (generated by `viber run` — edit the XML, not this block) ===
const CFG_DRIVE: f32 = 1.0;
const CFG_CLOCK_START: f32 = 480.0;
const CFG_CLOCK_SPEED: f32 = 1.2;
const CFG_DAWN: f32 = 330.0;
const CFG_DUSK: f32 = 1170.0;
const CFG_MAX_ELEV: f32 = 62.0;
const CFG_MIN_ELEV: f32 = 8.0;
const CFG_AZ_BASE: f32 = 205.0;
const CFG_SUN_ELEV: f32 = 17.0;
const CFG_SUN_AZ: f32 = 205.0;
const CFG_WIND_X: f32 = 0.7;
const CFG_WIND_Z: f32 = 0.25;
const CFG_WIND_STRENGTH: f32 = 1.5;
const CFG_WAVE_AMP: f32 = 1.0;
// === END WORLD CONFIG ===

// ── Volume ───────────────────────────────────────────────────────────
// Extinção por metro de coluna (Beer–Lambert). O vermelho morre primeiro,
// que é o que dá o desvio azul-esverdeado com a profundidade em vez de um
// simples escurecer. Multiplicada pela `opacity` do corpo (uv.x).
const EXTINCTION: vec3<f32> = vec3<f32>(0.90, 0.44, 0.30);
/// Comprimento máximo de coluna considerado (m) — evita `inf` quando o
/// prepass não escreveu nada atrás da água (céu).
const MAX_PATH: f32 = 60.0;
/// Banda de espuma junto à margem (profundidade vertical, m).
const FOAM_DEPTH: f32 = 0.55;
/// Profundidade em que a lâmina começa a existir (m) — abaixo disto a água
/// desaparece em vez de terminar numa linha dura sobre a margem.
const SHORE_FADE: f32 = 0.30;

// ── Noise helpers ────────────────────────────────────────────────────
// Hash INTEIRO sobre o índice de célula. O hash float clássico
// (`fract(p * vec2(123.34, 456.21))`) colapsa em coordenadas de mundo
// grandes: num mapa de 4 km, `x·123.34` chega a ~2.5e5, onde o espaçamento
// do f32 já é ~0.015 — o `fract` fica com uma mão-cheia de valores distintos
// e o ruído degenera em degraus rectos. Eram essas as faixas alinhadas que
// se viam a atravessar o lago. Aritmética u32 não tem esse problema.
fn hash21(p: vec2<f32>) -> f32 {
    let q = vec2<i32>(floor(p));
    var h = bitcast<u32>(q.x) * 0x27d4eb2du ^ bitcast<u32>(q.y) * 0x165667b1u;
    h = (h ^ (h >> 15u)) * 0x2c1b3c6du;
    h = (h ^ (h >> 13u)) * 0x297a2d39u;
    h = h ^ (h >> 16u);
    return f32(h & 0x00ffffffu) * (1.0 / 16777216.0);
}

fn value_noise(p: vec2<f32>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    // Quintic (smootherstep): a cúbica do smoothstep deixa a derivada
    // descontínua na fronteira da célula, e é ESSA descontinuidade que
    // aparecia como a grelha de quadrados na lâmina de água.
    let u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    let a = hash21(i);
    let b = hash21(i + vec2(1.0, 0.0));
    let c = hash21(i + vec2(0.0, 1.0));
    let d = hash21(i + vec2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

/// FBM com rotação por oitava — sem a rotação todas as oitavas partilham os
/// eixos da grelha do `value_noise` e somam-se em xadrez alinhado a XZ.
fn fbm(p: vec2<f32>, drift: vec2<f32>) -> f32 {
    let rot = mat2x2<f32>(0.80, 0.60, -0.60, 0.80);
    var q = p;
    var amp = 0.5;
    var sum = 0.0;
    var norm = 0.0;
    for (var i = 0; i < 4; i += 1) {
        sum += (value_noise(q + drift * (1.0 + f32(i) * 0.35)) - 0.5) * amp;
        norm += amp;
        q = rot * q * 2.03 + vec2(11.7, 5.3);
        amp *= 0.5;
    }
    return sum / norm;
}

// ── Day clock (mirror of `worldsys::sun_drive` / shaders/sky.wgsl) ───
const PI: f32 = 3.141592653589793;
const MOON_ELEVATION_DEG: f32 = 52.0;

fn sun_elevation_deg(minute: f32, dawn: f32, dusk: f32, max_elevation: f32) -> f32 {
    if (minute >= dawn && minute < dusk) {
        let t = (minute - dawn) / (dusk - dawn);
        return sin(PI * t) * max_elevation;
    }
    let dusk_len = 24.0 * 60.0 - dusk + dawn;
    var t = (minute - dusk) / dusk_len;
    if (minute < dusk) {
        t = (minute + (24.0 * 60.0 - dusk)) / dusk_len;
    }
    return -abs(sin(PI * t)) * 25.0;
}

fn sun_azimuth_deg(minute: f32, dawn: f32, dusk: f32, base: f32) -> f32 {
    if (minute >= dawn && minute < dusk) {
        return base + 180.0 * (minute - dawn) / (dusk - dawn);
    }
    let dusk_len = 24.0 * 60.0 - dusk + dawn;
    var t = (minute - dusk) / dusk_len;
    if (minute < dusk) {
        t = (minute + (24.0 * 60.0 - dusk)) / dusk_len;
    }
    return base + 180.0 + 180.0 * t;
}

// Unit direction TOWARDS the sun/moon (world, Y-up) — same convention as
// `worldsys::sky_direction`, so the glint tracks the real directional light.
fn sky_direction(elevation_deg: f32, azimuth_deg: f32) -> vec3<f32> {
    let el = radians(elevation_deg);
    let az = radians(azimuth_deg);
    return normalize(vec3<f32>(cos(el) * sin(az), sin(el), cos(el) * cos(az)));
}

// ── Wave field ───────────────────────────────────────────────────────
// Quatro trens direccionais com direcções NÃO ortogonais e comprimentos de
// onda incomensuráveis (7.0 / 4.6 / 3.0 / 1.85 m) mais um FBM à deriva. A
// versão anterior somava três senos em ±wind/±perp com λ ≈ 11–30 m: as
// cristas alinhavam-se em duas famílias perpendiculares e liam-se como o
// xadrez de faixas rectas sobre o lago.
fn wave_height(p: vec2<f32>, t: f32) -> f32 {
    let wind = vec2<f32>(CFG_WIND_X, CFG_WIND_Z);
    let wdir = normalize(wind + vec2(1e-4, 0.0));
    let strength = clamp(CFG_WIND_STRENGTH, 0.05, 3.0);
    let speed = 0.7 + 0.5 * strength;

    // DOMAIN WARP: o campo é amostrado num domínio dobrado por noise lento à
    // deriva — sem isto os trens desenhavam FAMÍLIAS DE LINHAS PARALELAS (o
    // λ dominante de 7 m atravessava o rio em faixas regulares transversais,
    // o "xadrez de faixas" original). Com o warp as cristas curvam-se,
    // quebram-se e fundem-se organicamente.
    let warp = vec2<f32>(
        value_noise(p * 0.11 + vec2(t * 0.03, 0.0)),
        value_noise(p * 0.13 - vec2(0.0, t * 0.025)),
    ) * 2.2 - vec2(1.1);
    let q = p + warp;

    // Direcções giradas em relação ao vento (graus): 0, +34, -51, +73.
    let d0 = wdir;
    let d1 = vec2<f32>(wdir.x * 0.829 - wdir.y * 0.559, wdir.x * 0.559 + wdir.y * 0.829);
    let d2 = vec2<f32>(wdir.x * 0.629 + wdir.y * 0.777, -wdir.x * 0.777 + wdir.y * 0.629);
    let d3 = vec2<f32>(wdir.x * 0.292 - wdir.y * 0.956, wdir.x * 0.956 + wdir.y * 0.292);

    // k = 2π/λ; dispersão de águas profundas: ω ∝ √k (cristas curtas correm
    // mais devagar, o campo nunca "congela" num padrão repetido).
    let k0 = 0.897; let k1 = 1.366; let k2 = 2.094; let k3 = 3.396;
    var h = 0.0;
    h += sin(dot(q, d0) * k0 - t * sqrt(k0) * 1.35 * speed) * 0.22;
    h += sin(dot(q, d1) * k1 + t * sqrt(k1) * 1.10 * speed) * 0.18;
    h += sin(dot(q, d2) * k2 - t * sqrt(k2) * 0.95 * speed) * 0.12;
    h += sin(dot(q, d3) * k3 + t * sqrt(k3) * 0.80 * speed) * 0.07;

    let drift = wdir * t * 0.35 * speed;
    h += fbm(q * 0.9 + drift, drift * 0.4) * 0.62 * (0.6 + 0.4 * min(strength, 2.0));
    // `ripple` do <Lake> — amplitude das ondas (multiplier de mundo).
    return h * CFG_WAVE_AMP;
}

/// Normal por diferenças centrais. `damp` desliga progressivamente a onda com
/// a distância — sem isso as cristas ficam mais finas que o pixel ao longe e
/// o specular cintila (aliasing) numa malha regular.
fn wave_normal(p: vec2<f32>, t: f32, damp: f32) -> vec3<f32> {
    let e = 0.28;
    let hl = wave_height(p - vec2(e, 0.0), t);
    let hr = wave_height(p + vec2(e, 0.0), t);
    let hd = wave_height(p - vec2(0.0, e), t);
    let hu = wave_height(p + vec2(0.0, e), t);
    let gain = (0.75 + 0.35 * clamp(CFG_WIND_STRENGTH, 0.0, 2.0)) * damp * CFG_WAVE_AMP;
    return normalize(vec3<f32>((hl - hr) * gain, 2.0 * e, (hd - hu) * gain));
}

/// Jacobian do campo de ondas (espuma de CRISTA, estilo bevy_water): para
/// h = Σ A_i sin(θ_i), J = 1 + Σ A_i k_i² sin(θ_i) — J baixo = a crista está
/// a empinar e quebra em espuma. Os MESMOS quatro trens do `wave_height`
/// (direções, k, velocidades e amplitudes) — espelho linha a linha.
fn wave_jacobian(p: vec2<f32>, t: f32) -> f32 {
    let wind = vec2<f32>(CFG_WIND_X, CFG_WIND_Z);
    let wdir = normalize(wind + vec2(1e-4, 0.0));
    let strength = clamp(CFG_WIND_STRENGTH, 0.05, 3.0);
    let speed = 0.7 + 0.5 * strength;
    // O MESMO domain warp do `wave_height` — o jacobian espelha o campo.
    let warp = vec2<f32>(
        value_noise(p * 0.11 + vec2(t * 0.03, 0.0)),
        value_noise(p * 0.13 - vec2(0.0, t * 0.025)),
    ) * 2.2 - vec2(1.1);
    let q = p + warp;

    let d0 = wdir;
    let d1 = vec2<f32>(wdir.x * 0.829 - wdir.y * 0.559, wdir.x * 0.559 + wdir.y * 0.829);
    let d2 = vec2<f32>(wdir.x * 0.629 + wdir.y * 0.777, -wdir.x * 0.777 + wdir.y * 0.629);
    let d3 = vec2<f32>(wdir.x * 0.292 - wdir.y * 0.956, wdir.x * 0.956 + wdir.y * 0.292);

    let k0 = 0.897; let k1 = 1.366; let k2 = 2.094; let k3 = 3.396;
    var j = 1.0;
    j += sin(dot(q, d0) * k0 - t * sqrt(k0) * 1.35 * speed) * 0.22 * k0 * k0;
    j += sin(dot(q, d1) * k1 + t * sqrt(k1) * 1.10 * speed) * 0.18 * k1 * k1;
    j += sin(dot(q, d2) * k2 - t * sqrt(k2) * 0.95 * speed) * 0.12 * k2 * k2;
    j += sin(dot(q, d3) * k3 + t * sqrt(k3) * 0.80 * speed) * 0.07 * k3 * k3;
    return j;
}

// ── Vertex displacement (estilo bevy_water) ──────────────────────────────
// O pacote bevy_water põe as ondas no VÉRTICE: a malha sobe/desce com o
// campo, as cristas ganham parallax real e a silhueta contra a margem mexe.
// O Bevy 0.19 usa o vertex da extensão NO LUGAR do base, por isso esta
// função replica o `mesh.wgsl` inteiro (transform, normais, cores) e
// acrescenta só a elevação. O ganho é PRÓPRIO (centímetros): a normal do
// fragmento já é um campo estilizado forte — aqui o que se move é a
// geometria, não a luz. A máscara de margem (alpha da cor) desvanece o
// deslocamento até zero na beira — a lâmina nunca descola do banco.
const VERTEX_WAVE_GAIN: f32 = 0.16;

#ifdef MORPH_TARGETS
fn morph_vertex(vertex_in: Vertex, instance_index: u32) -> Vertex {
    var vertex = vertex_in;
    let first_vertex = mesh[instance_index].first_vertex_index;
    let vertex_index = vertex.index - first_vertex;

    let weight_count = bevy_pbr::morph::layer_count(instance_index);
    for (var i: u32 = 0u; i < weight_count; i ++) {
        let weight = bevy_pbr::morph::weight_at(i, instance_index);
        if weight == 0.0 {
            continue;
        }
        vertex.position += weight * morph_position(vertex_index, i, instance_index);
#ifdef VERTEX_NORMALS
        vertex.normal += weight * morph_normal(vertex_index, i, instance_index);
#endif
#ifdef VERTEX_TANGENTS
        vertex.tangent += vec4(morph_tangent(vertex_index, i, instance_index), 0.0);
#endif
    }
    return vertex;
}
#endif

@vertex
fn vertex(vertex_no_morph: Vertex) -> VertexOutput {
    var out: VertexOutput;

#ifdef MORPH_TARGETS
    var vertex = morph_vertex(vertex_no_morph, vertex_no_morph.instance_index);
#else
    var vertex = vertex_no_morph;
#endif

    let mesh_world_from_local = mesh_functions::get_world_from_local(vertex_no_morph.instance_index);

#ifdef SKINNED
    var world_from_local = skinning::skin_model(
        vertex.joint_indices,
        vertex.joint_weights,
        vertex_no_morph.instance_index
    );
#else
    var world_from_local = mesh_world_from_local;
#endif

#ifdef VERTEX_NORMALS
#ifdef SKINNED
    out.world_normal = skinning::skin_normals(world_from_local, vertex.normal);
#else
    out.world_normal = mesh_functions::mesh_normal_local_to_world(
        vertex.normal,
        vertex_no_morph.instance_index
    );
#endif
#endif

#ifdef VERTEX_POSITIONS
    out.world_position = mesh_functions::mesh_position_local_to_world(world_from_local, vec4<f32>(vertex.position, 1.0));
#ifdef VERTEX_COLORS
    // Água: a elevação entra AQUI, entre o mundo e o clip. Sem cores na
    // malha (contrato quebrado) o deslocamento fica desligado — o shader
    // continua a ser um vertex base válido.
    let shore = smoothstep(0.0, 0.35, vertex.color.a);
    let lift = wave_height(out.world_position.xz, globals.time) * VERTEX_WAVE_GAIN * shore;
    out.world_position = vec4<f32>(
        out.world_position.x,
        out.world_position.y + lift,
        out.world_position.z,
        out.world_position.w,
    );
#endif
    out.position = vt::position_world_to_clip(out.world_position.xyz);
#endif

#ifdef VERTEX_UVS_A
    out.uv = vertex.uv;
#endif
#ifdef VERTEX_UVS_B
    out.uv_b = vertex.uv_b;
#endif

#ifdef VERTEX_TANGENTS
    out.world_tangent = mesh_functions::mesh_tangent_local_to_world(
        world_from_local,
        vertex.tangent,
        vertex_no_morph.instance_index
    );
#endif

#ifdef VERTEX_COLORS
    out.color = vertex.color;
#endif

#ifdef VERTEX_OUTPUT_INSTANCE_INDEX
    out.instance_index = vertex_no_morph.instance_index;
#endif

#ifdef VISIBILITY_RANGE_DITHER
    out.visibility_range_dither = mesh_functions::get_visibility_range_dither_level(
        vertex_no_morph.instance_index, mesh_world_from_local[3]);
#endif

    return out;
}

// ── Fragment ─────────────────────────────────────────────────────────
@fragment
fn fragment(
    in: VertexOutput,
    @builtin(front_facing) is_front: bool,
) -> FragmentOutput {
    var pbr_input = pbr_input_from_standard_material(in, is_front);

    let t = globals.time;
    let world = pbr_input.world_position.xyz;
    // Contrato da malha: alpha = máscara de margem, uv.x = `opacity` do corpo.
    let mask = pbr_input.material.base_color.a;
#ifdef VERTEX_UVS_A
    let murk = clamp(in.uv.x, 0.05, 1.0);
#else
    let murk = 0.75;
#endif

    pbr_input.material.base_color = alpha_discard(pbr_input.material, pbr_input.material.base_color);

    let cam_dist = length(view.world_position - world);
    let damp = 1.0 / (1.0 + cam_dist * 0.010);

    // Animated surface: perturb the geometric normal towards the wave field.
    let n = wave_normal(world.xz, t, damp);
    // Seen from below keep the flipped geometric normal (front_facing path
    // already normalized it); from above blend in the waves — mix alto
    // (0.92): a 0.85 o campo lia-se quase plano em céu difuso.
    pbr_input.N = select(pbr_input.N, normalize(mix(pbr_input.N, n, 0.92)), is_front);

    // Altura da onda no ponto — modula a COR (cristas mais claras, vales
    // mais escuros). Sob céu encoberto o specular/glint morre e, sem isto,
    // a superfície lê-se como um espelho liso (o "aerogel parado"): a
    // variação difusa é o que mantém a água viva em qualquer luz.
    let hh = wave_height(world.xz, t);
    let wave_tint = 1.0 + 0.22 * clamp(hh, -1.0, 1.0);
    // Correnteza: faixas de noise à deriva na direção do vento — vendem
    // FLUXO (o campo anda com t) em cor, não em specular.
    let streak = fbm(world.xz * vec2<f32>(0.5, 1.1) + vec2<f32>(t * 0.3, 0.0),
                     vec2<f32>(t * 0.09, 0.0));

    // ── Coluna de água (profundidade ASSADA nos vértices) ──────────────
    // `uv.y` transporta a profundidade VERTICAL da coluna (water_y − leito),
    // assada no build da malha a partir da MESMA grid do carve — analítica e
    // LOD-independente. (O depth prepass que aqui se lia mudava com o LOD do
    // terreno nas fronteiras de chunk e desenhava faixas no corpo; o
    // fallback de coluna constante, ao lado de leituras reais, era outra
    // faixa. Um deck de estrada acima da lâmina também já não "seca" o rio
    // — a coluna é o que a grid diz, não o que o prepass vê.)
    var path = 2.2;
    var depth_v = 2.2;
#ifdef VERTEX_UVS_A
    depth_v = max(in.uv.y, 0.05);
    // Caminho óptico: coluna vertical a dividir pelo cosseno do ângulo de
    // visão (raio reto — suave, sem amostras por pixel).
    let to_cam = normalize(view.world_position - world);
    path = clamp(depth_v / max(to_cam.y, 0.06), 0.0, MAX_PATH);
#endif

    let ext = EXTINCTION * (0.45 + 1.55 * murk);
    let transmit = exp(-path * ext);
    let absorb = clamp(1.0 - dot(transmit, vec3<f32>(1.0 / 3.0)), 0.0, 1.0);
    // Margem: a lâmina nasce da profundidade, não de um anel de vértices —
    // é isto que substitui o contorno duro do disco sobre o banco. O piso de
    // 0.45 (era 0.55) já não defende leituras falsas do prepass — a coluna é
    // analítica — só segura o fade de malha perto da margem.
    let shore = max(smoothstep(0.0, SHORE_FADE, depth_v), 0.45);

    // Day clock → sun/moon direction and daylight factor (mirrors worldsys).
    var minute = CFG_CLOCK_START;
    if (CFG_DRIVE > 0.5) {
        minute = (CFG_CLOCK_START + CFG_CLOCK_SPEED * t) % 1440.0;
    }
    let day = clamp((minute - (CFG_DAWN - 60.0)) / 60.0, 0.0, 1.0)
        * (1.0 - clamp((minute - CFG_DUSK) / 60.0, 0.0, 1.0));
    let sun_el = sun_elevation_deg(minute, CFG_DAWN, CFG_DUSK, CFG_MAX_ELEV);
    let sun_az = sun_azimuth_deg(minute, CFG_DAWN, CFG_DUSK, CFG_AZ_BASE);
    // The directional light parks at min elevation during the day arc and at
    // the moon (opposite azimuth) at night — mirror `sun_drive` for the glint.
    var glint_dir = sky_direction(CFG_SUN_ELEV, CFG_SUN_AZ);
    var glint_color = vec3<f32>(1.0, 0.95, 0.85);
    var glint_strength = 1.0;
    if (CFG_DRIVE > 0.5) {
        let sun_world = sky_direction(max(sun_el, CFG_MIN_ELEV), sun_az);
        let moon_world = sky_direction(MOON_ELEVATION_DEG, sun_az + 180.0);
        glint_dir = normalize(mix(moon_world, sun_world, day));
        glint_color = mix(vec3<f32>(0.40, 0.54, 0.86), vec3<f32>(1.0, 0.95, 0.85), day);
        glint_strength = 0.22 + 0.78 * day;
    }

    // Fresnel: normal QUASE plana (o feed com a normal ondulada fazia a
    // opacidade variar crista a crista — faixas rectas sobre as margens). O
    // mix sobe um pouco (0.18 → 0.24) para a face ganhar vida sem voltar às
    // faixas.
    let n_flat = normalize(mix(vec3<f32>(0.0, 1.0, 0.0), pbr_input.N, 0.24));
    let nv = clamp(dot(n_flat, pbr_input.V), 0.0, 1.0);
    let fres = mix(0.02, 1.0, pow(1.0 - nv, 5.0));

    // Cheap sky reflection tint towards the horizon at grazing angles.
    let day_sky = vec3<f32>(0.36, 0.56, 0.78);
    let night_sky = vec3<f32>(0.05, 0.07, 0.13);
    let sunset = vec3<f32>(0.85, 0.45, 0.26);
    let low_sun = 1.0 - clamp(abs(sun_el) / 18.0, 0.0, 1.0);
    var sky_tint = mix(night_sky, day_sky, day);
    sky_tint = mix(sky_tint, sunset, low_sun * 0.45);

    // Espuma de margem: banda animada onde a coluna é rasa. Dá a leitura de
    // "onde a água acaba" que o fade radial da malha nunca deu.
    let foam_band = 1.0 - smoothstep(0.0, FOAM_DEPTH, depth_v);
    let foam_noise = 0.55 + 0.45 * fbm(world.xz * 1.6 + vec2(0.0, t * 0.25), vec2(t * 0.12, 0.0)) * 2.0;
    // Espuma de CRISTA (jacobian, estilo bevy_water): onde o campo empina a
    // onda quebra — independe da margem, aparece em todo o corpo com vento.
    // `damp`/`shore` seguram as cristas ao longe e na beira.
    let crest = (1.0 - smoothstep(0.0, 0.7, wave_jacobian(world.xz, t)))
        * clamp(CFG_WIND_STRENGTH, 0.0, 2.0) * 0.75 * damp * shore;
    let foam = clamp(foam_band * foam_band * foam_noise + crest, 0.0, 1.0) * shore * 0.75;

    // Corpo: cor rasa → cor profunda ao longo da absorção. O reflexo do CÉU
    // agora entra pelo IBL real (apply_pbr_lighting com o env map do probe +
    // reflectance 1.0 do material): o tint analítico abaixo ficou residual
    // (0.10, era 0.22) — cobre só mundos sem IBL, para o espelho rasante
    // nunca ler preto. `wave_tint`/`streak` dão variação difusa
    // (cristas/correnteza) que sobrevive a céu encoberto.
    let body = pbr_input.material.base_color.rgb;
    let shallow = body * 1.35;
    let deep = body * 0.52;
    var col = mix(shallow, deep, absorb) * wave_tint;
    col += sky_tint * fres * 0.10;
    col = mix(col, col * 1.3 + vec3<f32>(0.02), streak * 0.35);
    col = mix(col, vec3<f32>(0.90, 0.94, 0.95), foam);

    // Opacidade: absorção do corpo + reflexão de Fresnel por cima, tudo
    // mascarado pela margem e pelo fade da malha.
    let opacity = clamp(absorb + (1.0 - absorb) * fres, 0.0, 1.0);
    let alpha = clamp(mask * shore * max(opacity, foam), 0.0, 1.0);
    pbr_input.material.base_color = vec4<f32>(col, alpha);

    // Wave crests roughen the mirror; calmer water stays glossy.
    // Base 0.22 (era 0.14): com reflectance 1.0 o lóbulo especular do IBL
    // espelhava o céu pálido como um borrão branco ("água leitosa") — mais
    // rugosidade espalha o reflexo e deixa a COR do corpo dominar.
    pbr_input.material.perceptual_roughness = clamp(
        0.22 + 0.06 * clamp(CFG_WIND_STRENGTH, 0.0, 2.0) + 0.35 * foam,
        0.02,
        1.0,
    );

    // Sun/moon glint: specular lobe, masked by sparkle noise so it shimmers
    // instead of forming one perfect blob. Emissive drives bloom. O lóbulo a
    // 360 era UM ponto — o sol baixo da golden hour não deixava rastro; 140
    // alarga o caminho de sol na água mantendo o cintilar.
    let reflect_dir = reflect(-glint_dir, pbr_input.N);
    let lobe = pow(max(dot(reflect_dir, pbr_input.V), 0.0), 140.0);
    // Ruído de cintilação a frequência alta (célula ~11 cm): a 5.5 as células
    // eram maiores que o lóbulo e o glint saía em manchas brancas contínuas.
    // `wind="0 0"` é autoral válido e normalize(vec2(0)) = NaN — mesmo guard
    // do `wave_height` (jitter 1e-4) para o drift do sparkle não envenenar
    // o glint.
    let sparkle_dir = normalize(vec2<f32>(CFG_WIND_X, CFG_WIND_Z) + vec2(1e-4, 0.0));
    let sparkle = pow(value_noise(world.xz * 9.0 + sparkle_dir * t * 2.1), 3.0);
    let glint = lobe * sparkle * 1.8 * glint_strength * glint_color * damp * (1.0 - foam);
    pbr_input.material.emissive = vec4<f32>(glint, 1.0);

    var out: FragmentOutput;
    out.color = apply_pbr_lighting(pbr_input);
    out.color = main_pass_post_lighting_processing(pbr_input, out.color);
    return out;
}
