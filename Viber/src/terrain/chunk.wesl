// Viber terrain material — UM material para o terreno inteiro.
//
// O splat é GLOBAL: 4 planos RGBA8 com os 13 pesos do pool por texel (~2 m),
// cozidos no CPU (`splat::generate_splats`) e lidos aqui com filtragem
// bilinear + mips — sem costuras de chunk. Por PIXEL ficam as 4 camadas de
// maior peso (renormalizadas); só essas são amostradas. A albedo leva uma
// 2.ª amostra rodada a outra escala, misturada por ruído de baixa
// frequência (anti-repetição), e o terreno todo uma variação macro de tom.
//
// WORLD SPECIALIZATION: `viber run` rewrites the CONFIG block below from the
// `<Terrain>` spec before the renderer loads this file.
//
// BINDINGS — o material é **bindless** (`TerrainChunkMaterial`), e tem de ser:
// um material custom NÃO-bindless com uma única textura faz SIGSEGV no driver
// NVIDIA dentro de `vkCreatePipelineLayout`. As texturas vivem nos arrays
// partilhados de `bevy_render::bindless`; a tabela de índices (binding 0) é
// lida como `array<u32>` — camada `i` do mapa M em `M_BASE + 2i` (sampler no
// índice seguinte). Sem bindless o terreno desenha a cor plana das camadas.

import bevy_pbr::render::forward_io::{VertexOutput, FragmentOutput};
import bevy_pbr::render::mesh_view_bindings::view;
// Pipeline PBR REAL: `apply_pbr_lighting` traz o sol direcional (com as
// cascades de sombra — o chão passa a receber as sombras das árvores/props),
// as luzes pontuais clusterizadas (as lanternas acendem o terreno à noite),
// a luz ambiente e o specular; `main_pass_post_lighting_processing` aplica a
// fog da câmara (define DISTANCE_FOG do view key + bit FOG_ENABLED abaixo).
// NÃO importar `bevy_pbr::pbr_fragment`: puxa `pbr_bindings::material_indices`
// (StandardMaterial) que CONFLITUA com a nossa tabela bindless em
// group(#{MATERIAL_BIND_GROUP}).binding(0) — o PbrInput é construído à mão.
import bevy_pbr::render::pbr_types::{pbr_input_new, STANDARD_MATERIAL_FLAGS_FOG_ENABLED_BIT};
import bevy_pbr::render::pbr_functions::{apply_pbr_lighting, main_pass_post_lighting_processing, calculate_view};
import bevy_pbr::render::pbr_lighting::perceptualRoughnessToRoughness;
import bevy_pbr::render::mesh_bindings::mesh;

@if(BINDLESS)
import bevy_render::bindless::{bindless_textures_2d, bindless_samplers_filtering};

// SSAO — a textura e o define vêm do view key (componente na câmara); sem o
// componente o bloco some e a oclusão fica 1.0.
@if(SCREEN_SPACE_AMBIENT_OCCLUSION)
import bevy_pbr::render::mesh_view_bindings::screen_space_ambient_occlusion_texture;
@if(SCREEN_SPACE_AMBIENT_OCCLUSION)
import bevy_pbr::ssao::utils::ssao_multibounce;

// === WORLD CONFIG (generated by `viber run` — edit the XML, not this block) ===
// HISTÓRICO: estes consts eram lidos pelo fragment; hoje os MESMOS valores
// entram no uniform (`TerrainChunkParams::walls_a`/`walls_b`, inicializados
// do XML pelo bootstrap) para `viber.debug.ground{...}` os mover AO VIVO.
// O bloco mantém-se por paridade com water/sky.
const CFG_TRI_SLOPE: f32 = 0.5;
const CFG_TRI_SOFT: f32 = 0.12;
const CFG_STRATA_SPACING: f32 = 4;
const CFG_STRATA_STRENGTH: f32 = 0.25;
const CFG_ROCK_DARKEN: f32 = 0.45;
const CFG_STREAK: f32 = 0.5;
const CFG_MOSS: f32 = 0.35;
// === END WORLD CONFIG ===

const LAYERS: u32 = 13u;
// Bindings da tabela (ver `TerrainChunkMaterial`): camada `i` em `BASE + 2i`.
const B_ALBEDO: u32 = 1u;
const B_NORMAL: u32 = 27u;
const B_HEIGHT: u32 = 53u;
const B_AO: u32 = 79u;
const B_ROUGH: u32 = 105u;
const B_SPLAT: u32 = 131u;

// Tabela de estilo, indexada pelo SLOT DO POOL (0..13). `world`: xy = canto
// (-X,-Z) do splat, z = lado em metros, w = slot da rocha das paredes.
struct TerrainChunkParams {
    tiles: array<vec4<f32>, 13>,
    tints: array<vec4<f32>, 13>,
    flats: array<vec4<f32>, 13>,
    roughs: array<vec4<f32>, 13>,
    world: vec4<f32>,
    day_tint: vec4<f32>,
    sun_dir: vec4<f32>,
    // walls_a = tri_slope, tri_soft, strata_spacing, strata_strength;
    // walls_b = rock_darken, streaks, moss, chuva.
    walls_a: vec4<f32>,
    walls_b: vec4<f32>,
};

@if(BINDLESS) {
// Uma entrada por material: o índice dos dados e as 138 entradas texture/
// sampler na ORDEM das bindings 1..138.
struct TerrainChunkBindings {
    material: u32,
    e: array<u32, 138>,
}

@group(constants::MATERIAL_BIND_GROUP) @binding(0) var<storage> material_indices: array<TerrainChunkBindings>;
@group(constants::MATERIAL_BIND_GROUP) @binding(10) var<storage> params_array: array<TerrainChunkParams>;
} @else {
@group(constants::MATERIAL_BIND_GROUP) @binding(0) var<uniform> params_direct: TerrainChunkParams;
}

// Achatamento por distância: perto vê-se o material, longe vê-se cor. FLAT_MIN
// é o achatamento mínimo colado à câmara — as fotos do pool têm contraste a
// mais para um mundo cel-ish mesmo aos pés do herói. r4 (2026-09-09): os
// limites esticaram (42/260 → 64/340) — o detalhe morria aos ~100 m e as
// encostas ao fundo liam-se como cor chapada; a aerial perspective
// (320–1100 m) assume o resto do caminho até ao horizonte.
const FLAT_NEAR: f32 = 64.0;
const FLAT_FAR: f32 = 340.0;
const FLAT_MIN: f32 = 0.15;
// Limiar do SALTO de fetches: a partir daqui o mix devolve a cor plana e a
// normal já pesa < 0,5 % — os fetches de COR e de NORMAL MAP de cada layer não
// contribuem (o de HEIGHT fica: alimenta os pesos; o de AO fica: escurece a
// distância através dos mips). Poupa 2 dos 4 fetches por layer em toda a
// banda de fundo, que é o material dominante do ecrã em enquadramentos abertos.
const FLAT_SKIP: f32 = 0.995;

// Weights below this contribute nothing visible; skipping their texture
// fetch keeps the typical fragment at 2–3 layers instead of 4.
const WEIGHT_EPSILON: f32 = 0.004;

// Height-bias CONTÍNUO: cada layer ganha/perde peso proporcional à SUA
// altura (`h−0.5`), com teto/piso — a layer alta sai à frente na fronteira
// (a pedra sobre a relva) SEM colapso. A primeira versão redistribuía o
// PAR dominante com força 12: a layer perdedora colapsava a 0 e as
// fronteiras do splat — que são suaves — endureciam em LINHAS RETAS
// ("uma textura acaba, a outra começa", 2026-09-09). Multiplicativo com
// clamp é contínuo em todo o lado e mantém a largura da transição.
const HEIGHT_BIAS: f32 = 2.5;
/// Piso do multiplicador: a layer baixa nunca perde mais do que 65% do
/// peso — impossível desaparecer de golpe.
const HEIGHT_BIAS_MIN: f32 = 0.35;

// Força do AO do pool sobre o albedo (1 = total; 0.6 mantém o chão vivo).
const AO_STRENGTH: f32 = 0.6;


fn terrain_params(slot: u32) -> TerrainChunkParams {
    @if(BINDLESS)
    return params_array[material_indices[slot].material];
    @else
    return params_direct;
}

/// Uma textura da tabela (binding `b` = textura, `b + 1` = sampler) com
/// gradientes explícitos (legal no fluxo não-uniforme por camada).
fn map_sample(slot: u32, b: u32, uv: vec2<f32>, dx: vec2<f32>, dy: vec2<f32>) -> vec4<f32> {
    @if(BINDLESS) {
    let idx = material_indices[slot];
    return textureSampleGrad(
        bindless_textures_2d[idx.e[b - 1u]],
        bindless_samplers_filtering[idx.e[b]],
        uv,
        dx,
        dy,
    );
    } @else {
    // Sem bindless não há texturas: neutro (o albedo cai na cor plana).
    return vec4<f32>(0.5, 0.5, 1.0, 1.0);
    }
}

fn layer_albedo(slot: u32, li: u32, uv: vec2<f32>, dx: vec2<f32>, dy: vec2<f32>) -> vec3<f32> {
    return map_sample(slot, B_ALBEDO + 2u * li, uv, dx, dy).rgb;
}

// ── Wall skin (deterministic hash noise — the rock detail needs no extra
// textures or bindings). Value noise in 2 octaves drives the runoff
// streaks and the moss patches.
fn hash21(p: vec2<f32>) -> f32 {
    return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);
}
fn vnoise(p: vec2<f32>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * (3.0 - 2.0 * f);
    let a = mix(hash21(i), hash21(i + vec2<f32>(1.0, 0.0)), u.x);
    let b = mix(hash21(i + vec2<f32>(0.0, 1.0)), hash21(i + vec2<f32>(1.0, 1.0)), u.x);
    return mix(a, b, u.y);
}

// Anti-repetição: a 2.ª amostra roda ~34° e muda de escala (×0,37), e a
// mistura entre as duas segue um ruído de ~40 m — o padrão do azulejo deixa
// de alinhar ao longe.
const ANTI_TILE_SCALE: f32 = 0.37;
const ANTI_TILE_COS: f32 = 0.829;
const ANTI_TILE_SIN: f32 = 0.559;
const ANTI_TILE_MIX: f32 = 0.55;
// Variação macro de tom (campos de ~170 m e ~55 m): quebra a uniformidade das
// grandes áreas da mesma camada, perto e longe.
const MACRO_LOW: f32 = 0.88;
const MACRO_HIGH: f32 = 1.10;

fn anti_tile(v: vec2<f32>) -> vec2<f32> {
    return vec2<f32>(
        ANTI_TILE_COS * v.x - ANTI_TILE_SIN * v.y,
        ANTI_TILE_SIN * v.x + ANTI_TILE_COS * v.y,
    ) * ANTI_TILE_SCALE;
}

@fragment
fn fragment(
    in: VertexOutput,
    @builtin(front_facing) is_front: bool,
) -> FragmentOutput {
    @if(BINDLESS)
    let slot = mesh[in.instance_index].material_and_lightmap_bind_group_slot & 0xffffu;
    @else
    let slot = 0u;
    var params = terrain_params(slot);

    let world = in.world_position.xyz;
    let normal = select(-in.world_normal, in.world_normal, is_front);

    // Splat GLOBAL: uv 0..1 sobre o mundo; gradientes tirados UMA vez aqui.
    let suv = (world.xz - params.world.xy) / params.world.z;
    let sdx = dpdx(suv);
    let sdy = dpdy(suv);
    let p0 = map_sample(slot, B_SPLAT, suv, sdx, sdy);
    let p1 = map_sample(slot, B_SPLAT + 2u, suv, sdx, sdy);
    let p2 = map_sample(slot, B_SPLAT + 4u, suv, sdx, sdy);
    let p3 = map_sample(slot, B_SPLAT + 6u, suv, sdx, sdy);
    // Empacotamento = `splat::SLOT_PACKING` (plano, canal) por slot.
    var w = array<f32, 13>(
        p0.r, p0.g, p0.b, p0.a,
        p1.r, p1.g, p1.b, p1.a,
        p2.r, p2.g, p2.b, p2.a,
        p3.r,
    );
    // As 4 camadas mais fortes deste pixel (inserção ordenada).
    var ids = array<u32, 4>(0u, 0u, 0u, 0u);
    var ws = array<f32, 4>(0.0, 0.0, 0.0, 0.0);
    for (var i = 0u; i < LAYERS; i++) {
        var v = w[i];
        var id = i;
        for (var k = 0u; k < 4u; k++) {
            if (v > ws[k]) {
                let tv = ws[k];
                let ti = ids[k];
                ws[k] = v;
                ids[k] = id;
                v = tv;
                id = ti;
            }
        }
    }
    let wtop = max(ws[0] + ws[1] + ws[2] + ws[3], 1e-4);

    // World-space derivative shared by every layer (uv = world / tile).
    let wdx = dpdx(world.xz);
    let wdy = dpdy(world.xz);

    // Achatamento por distância: perto vê-se o material, longe vê-se cor.
    let view_dist = distance(world, view.world_position.xyz);
    let flat_mix = mix(FLAT_MIN, 1.0, smoothstep(FLAT_NEAR, FLAT_FAR, view_dist));
    let tile_mix = smoothstep(0.30, 0.70, vnoise(world.xz / 40.0)) * ANTI_TILE_MIX;

    var albedo = vec3<f32>(0.0);
    var rough = 0.0;
    var ao = 0.0;
    var wsum = 0.0;
    // Frame tangente derivado da normal geométrica (projeção top-down).
    let ng = normalize(normal);
    let cross_up = cross(vec3<f32>(0.0, 1.0, 0.0), ng);
    let t_axis = select(vec3<f32>(1.0, 0.0, 0.0), normalize(cross_up), dot(cross_up, cross_up) > 1e-8);
    let b_axis = cross(ng, t_axis);
    var n_world = vec3<f32>(0.0);

    for (var k = 0u; k < 4u; k++) {
        let wk = ws[k] / wtop;
        if (wk <= WEIGHT_EPSILON) {
            continue;
        }
        let li = ids[k];
        let t = params.tiles[li].x;
        let uv_t = world.xz / t;
        let gx = wdx / t;
        let gy = wdy / t;
        var tex = params.flats[li].rgb;
        if (flat_mix < FLAT_SKIP) {
            var c = layer_albedo(slot, li, uv_t, gx, gy);
            if (tile_mix > 0.01) {
                // Desvio por camada: duas camadas nunca alinham o 2.º padrão.
                let shift = vec2<f32>(f32(li) * 0.173, f32(li) * 0.311);
                let c2 = layer_albedo(slot, li, anti_tile(uv_t) + shift, anti_tile(gx), anti_tile(gy));
                c = mix(c, c2, tile_mix);
            }
            tex = c * params.tints[li].rgb;
        }
        // Height-bias CONTÍNUO: multiplicador com piso — a camada alta ganha
        // peso na fronteira, a baixa perde um pouco, NINGUÉM colapsa.
        let h = map_sample(slot, B_HEIGHT + 2u * li, uv_t, gx, gy).r;
        let wb = wk * max(1.0 + HEIGHT_BIAS * (h - 0.5), HEIGHT_BIAS_MIN);
        albedo += wb * mix(tex, params.flats[li].rgb, flat_mix);
        if (params.roughs[li].y > 0.0) {
            let rmap = map_sample(slot, B_ROUGH + 2u * li, uv_t, gx, gy).r;
            let rinv = select(rmap, 1.0 - rmap, params.roughs[li].z > 0.5);
            rough += wb * mix(params.roughs[li].x, rinv, params.roughs[li].y);
        } else {
            rough += wb * params.roughs[li].x;
        }
        ao += wb * map_sample(slot, B_AO + 2u * li, uv_t, gx, gy).r;
        wsum += wb;
        let kd = 1.0 - flat_mix;
        if (kd >= 1.0 - FLAT_SKIP) {
            let nm = map_sample(slot, B_NORMAL + 2u * li, uv_t, gx, gy).rgb * 2.0 - 1.0;
            n_world += wb * (t_axis * (nm.x * kd) + b_axis * (nm.y * kd) + ng * (nm.z * kd + (1.0 - kd)));
        } else {
            n_world += wb * ng;
        }
    }

    let total = max(wsum, 1e-4);
    albedo /= total;
    rough = clamp(rough / total, 0.05, 1.0);
    albedo *= mix(1.0, ao / total, AO_STRENGTH);
    // Variação macro de tom (perto e longe).
    let macro_n = vnoise(world.xz / 170.0) * 0.6 + vnoise(world.xz / 55.0) * 0.4;
    albedo *= mix(MACRO_LOW, MACRO_HIGH, macro_n);
    let n_detail = normalize(select(ng, n_world, dot(n_world, n_world) > 1e-8));

    // ── Cliff walls: triplanar 2-fetch + estratos ─────────────────────────
    //
    // A projeção top-down do splat estica-se nas paredes ("plastilina").
    // Faces mais íngremes que o cliff-angle (`params.walls_a.x`; ≥ 1 desliga o
    // caminho, const-folded) trocam o blend splat pela ROCK layer do chunk
    // (a mountain_stone quando o chunk a carregou), com bandas de estratos
    // em world.y a fazerem a parede ler como rocha sedimentar.
    var wall_n = vec3<f32>(0.0, 1.0, 0.0);
    var tri_mix = 0.0;
    if (params.walls_a.x < 1.0) {
        // O declive vem da normal INTERPOLADA, não das derivadas de ecrã.
        // `cross(dpdx(world), dpdy(world))` é a normal do TRIÂNGULO: constante
        // dentro dele e descontínua na aresta, por isso o gate saltava de
        // triângulo para triângulo e a encosta enchia-se de manchas de pedra
        // com bordas poligonais retas (o "faixas/manchas nas montanhas"). A
        // normal do vértice vem de `HeightField::sample_normal` com um épsilon
        // constante em todo o terreno: é suave entre triângulos E estável
        // entre LODs, portanto o mesmo pixel não muda de rocha para relva
        // quando o chunk troca de nível.
        let geom_n = normal;
        let slope = 1.0 - abs(geom_n.y);
        // Gate DUPLA: declive × fator de região — o
        // alpha das vertex colors transporta a máscara de cliff FILTRADA
        // (componentes conexos com área/queda/extent mínimos, cozida no
        // mesh builder). Um declive espúrio isolado tem fator 0 e nunca
        // ganha pedra; a borda de região faz blend suave. O canal R
        // transporta o WALL SPACE da máscara (0 = brow, 1 = pé, 0.5
        // neutro): meteorização, AO de contacto e a distribuição de
        // escorrimentos/musgo leem-se dele.
        var region = 1.0;
        var wall = 0.5;
        @if(VERTEX_COLORS)
        {
            region = clamp(in.color.a, 0.0, 1.0);
            wall = clamp(in.color.r, 0.0, 1.0);
        }
        let tri = smoothstep(params.walls_a.x, params.walls_a.x + params.walls_a.y, slope) * region;
        if (tri > 0.001) {
            let rock = u32(params.world.w);
            if (rock < LAYERS) {
                // Só mistura a normal de parede quando o chunk TEM rock —
                // sem ela o bump ficava (0,1,0) e a parede lia iluminada
                // como chão plano (flat/estourada).
                tri_mix = tri;
                let uv_zy = vec2<f32>(world.z, world.y);
                let uv_xy = vec2<f32>(world.x, world.y);
                let dzy_x = dpdx(uv_zy);
                let dzy_y = dpdy(uv_zy);
                let dxy_x = dpdx(uv_xy);
                let dxy_y = dpdy(uv_xy);
                let use_xy = abs(geom_n.x) < abs(geom_n.z);
                let side = select(uv_zy, uv_xy, use_xy);
                let sd = select(dzy_x, dxy_x, use_xy);
                let sy = select(dzy_y, dxy_y, use_xy);
                let t = params.tiles[rock].x;
                let rock_tex = layer_albedo(slot, rock, side / t, sd / t, sy / t);
                // Detail normal do LUMINANCE (fallback sem bindings novas):
                // 2 fetches extra na MESMA textura — o gradiente de
                // luminância é o relevo da rocha. Some ao brilho à
                // distância (flat_mix) para não cintilar longe.
                let luma = vec3<f32>(0.299, 0.587, 0.114);
                let bump = 1.1 * (1.0 - flat_mix);
                if (bump > 0.01) {
                    let e = 0.35 / t;
                    let c0 = dot(rock_tex, luma);
                    let cu = dot(layer_albedo(slot, rock, side / t + vec2<f32>(e, 0.0), sd / t, sy / t), luma);
                    let cv = dot(layer_albedo(slot, rock, side / t + vec2<f32>(0.0, e), sd / t, sy / t), luma);
                    let u_axis = select(vec3<f32>(0.0, 0.0, 1.0), vec3<f32>(1.0, 0.0, 0.0), use_xy);
                    wall_n = normalize(geom_n
                        - (u_axis * (cu - c0) + vec3<f32>(0.0, 1.0, 0.0) * (cv - c0)) * bump);
                }
                let band = world.y / params.walls_a.z;
                let band_id = floor(band);
                let hue = fract(sin(band_id * vec3<f32>(12.9898, 78.233, 37.719)) * 43758.5453);
                // Estratos cromáticos: cada banda puxa para um tom próprio
                // (quente ↔ frio) e 1 em 4 bandas é um banco DURO — mais
                // claro, o estrato resistente que sai à frente na erosão.
                let warm = vec3<f32>(
                    1.0 - params.walls_a.w,
                    1.0 - params.walls_a.w * 0.75,
                    1.0 - params.walls_a.w * 0.45,
                );
                let cool = vec3<f32>(
                    1.0 + params.walls_a.w * 0.45,
                    1.0 + params.walls_a.w * 0.75,
                    1.0 + params.walls_a.w,
                );
                let band_tint = mix(warm, cool, hue);
                let band_mod = band_id - floor(band_id * 0.25) * 4.0;
                let hard = step(band_mod, 0.5) * 0.14;
                let line = smoothstep(0.82, 1.0, fract(band)) * params.walls_a.w * 0.8;
                // ── Fade dos detalhes SUB-PIXEL ────────────────────────────
                // Estratos (4 m), escorrimentos (~4 m) e o bump de luminância
                // são detalhe de PERTO. A 300 m uma banda de 4 m ocupa ~1 px:
                // o passo `floor(world.y / 4)` deixa de ser rocha sedimentar e
                // vira aliasing — riscas horizontais claras/escuras a
                // atravessar a montanha inteira (o "faixas nas montanhas"). O
                // mesmo `flat_mix` que já achata a textura por distância
                // desliga-os: perto nada muda, longe fica a cor plana da
                // camada. Sem isto nenhum mipmap ajuda — a banda é aritmética
                // no fragmento, não um texel.
                let detail = 1.0 - flat_mix;
                // params.walls_b.x: a parede le PEDRA ESCURA mesmo sob
                // paletas claras — os tints por slot existem para o chao a
                // pleno sol (mountain_stone clareia 1.35x); o rochedo
                // devolve o texel a ~45% (o escuro do basalto da referencia).
                var rock_col = rock_tex * params.tints[rock].rgb * params.walls_b.x
                    * mix(vec3<f32>(1.0), band_tint, detail)
                    * (1.0 - line * detail)
                    * (1.0 + hard * detail);
                // Meteorização vertical (wall space): o brow seca ao sol,
                // o pé ganha poeira de detrito; AO de contacto onde a
                // parede encosta no chão; escorrimentos — faixas verticais
                // de água (noise esticado em Y), mais fortes na metade
                // inferior onde a humidade escorre.
                let weather = mix(1.06, 0.88, wall);
                let toe_ao = 1.0 - 0.38 * smoothstep(0.82, 0.98, wall);
                let su = vec2<f32>((world.x + world.z) * 0.22, world.y * 0.06);
                let streak_n = vnoise(su) * 0.65 + vnoise(su * 2.7) * 0.35;
                let streak = 1.0
                    - params.walls_b.y * detail * smoothstep(0.48, 0.88, streak_n) * mix(0.55, 1.0, wall);
                rock_col = rock_col * weather * toe_ao * streak;
                rock_col = mix(rock_col, params.flats[rock].rgb, flat_mix);
                albedo = mix(albedo, rock_col, tri);
                rough = mix(rough, params.roughs[rock].x, tri);
            }
        }
        // Musgo procedural: manchas húmidas nos OMBROS e flancos médios da
        // região de cliff (declive médio — nem o plano da relva, nem a face
        // nua), mais denso perto do pé onde a humidade se acumula. O gate
        // pela `region` impede musgo em colinas longe de qualquer parede.
        // Também desvanece com a distância: as manchas têm ~6 m e ao longe
        // viravam salpicos verdes de 1 px na encosta.
        let moss_n = vnoise(world.xz * 0.17) * 0.6 + vnoise(world.xz * 0.51) * 0.4;
        let moss_band = smoothstep(0.10, 0.20, slope) * (1.0 - smoothstep(0.50, 0.78, slope));
        let moss = params.walls_b.z * region * moss_band * (1.0 - flat_mix)
            * smoothstep(0.50, 0.78, moss_n)
            * mix(0.55, 1.25, wall);
        albedo = mix(albedo, vec3<f32>(0.17, 0.24, 0.08), clamp(moss, 0.0, 0.85));
    }

    // ── Chuva: chão molhado (r3) ────────────────────────────────────────────
    // `walls_b.w` transporta a chuva (0..1, publisher `terrain_rain_wetness`).
    // Molhar = escurecer o albedo (água absorve) e abrir um gloss de poça no
    // CHÃO plano (a rocha das paredes já é rugosa ao natural); o specular do
    // sol/IBL faz o resto.
    let wet = clamp(params.walls_b.w, 0.0, 1.0) * (1.0 - clamp(tri_mix, 0.0, 1.0) * 0.7);
    if (wet > 0.001) {
        albedo *= mix(1.0, 0.72, wet);
        rough = mix(rough, 0.16, wet);
    }

    // ── Aerial perspective (r2) ────────────────────────────────────────────
    // `day_tint` transporta agora o TINT DO HORIZONTE publicado pela
    // atmosfera (`w = 1` liga): o chão distante mistura-se para a cor do céu
    // ANTES da luz e da fog — as montanhas ao fundo leem-se da cor do ar
    // (azuis de dia, cor de crepúsculo à hora dourada) em vez de cinza
    // estéril. O achatamento FLAT_FAR dá-lhe a cor plana da layer; ISTO dá o
    // degradê atmosférico por cima dela.
    if (params.day_tint.w > 0.5) {
        let aerial = smoothstep(320.0, 1100.0, view_dist) * 0.55;
        albedo = mix(albedo, params.day_tint.rgb, aerial);
    }

    // ── PBR real ──────────────────────────────────────────────────────────
    // Sol direcional com sombras em cascata, luzes pontuais (clustered),
    // ambiente e specular — o mesmo caminho do StandardMaterial alimentado
    // com o nosso albedo/normal de 8 layers + triplanar. O `day_tint` do
    // caminho fake SAIU do albedo: com luz real, a hora do dia já escurece
    // e aquece o chão (sun_drive + daycycle_drive) e o tint compunha-se
    // duas vezes. `sun_dir`/`day_tint` continuam no uniform por compatibilidade
    // de layout (e para o `viber.debug.ground{...}`) mas já não são lidos.
    let n = normalize(mix(n_detail, wall_n, clamp(tri_mix, 0.0, 1.0)));

    var pbr_input = pbr_input_new();
    pbr_input.flags = mesh[in.instance_index].flags;
    pbr_input.is_orthographic = view.clip_from_view[3].w == 1.0;
    pbr_input.V = calculate_view(in.world_position, pbr_input.is_orthographic);
    pbr_input.frag_coord = in.position;
    pbr_input.world_position = in.world_position;
    // A `world_normal` alimenta o normal-offset bias das sombras — normalizada,
    // com o flip de faces (cull off: a barriga dos overhangs é vista por dentro).
    pbr_input.world_normal = normalize(select(-in.world_normal, in.world_normal, is_front));
    pbr_input.N = n;
    // Opaco (alpha mode 0) + receptor de fog da câmara.
    pbr_input.material.flags = STANDARD_MATERIAL_FLAGS_FOG_ENABLED_BIT;
    pbr_input.material.base_color = vec4<f32>(albedo, 1.0);
    pbr_input.material.perceptual_roughness = rough;

    var diffuse_occlusion = vec3<f32>(1.0);
    var specular_occlusion = 1.0;
    @if(SCREEN_SPACE_AMBIENT_OCCLUSION)
    {
    let ssao = textureLoad(screen_space_ambient_occlusion_texture, vec2<i32>(in.position.xy), 0i).r;
    diffuse_occlusion = ssao_multibounce(ssao, albedo);
    // Lagarde and Rousiers 2014, "Moving Frostbite to Physically Based Rendering"
    let ndv = max(dot(n, pbr_input.V), 0.0001);
    let rough_linear = perceptualRoughnessToRoughness(rough);
    specular_occlusion = saturate(pow(ndv + ssao, exp2(-16.0 * rough_linear - 1.0)) - 1.0 + ssao);
    }
    pbr_input.diffuse_occlusion = diffuse_occlusion;
    pbr_input.specular_occlusion = specular_occlusion;

    var out: FragmentOutput;
    out.color = apply_pbr_lighting(pbr_input);
    // Fog da câmara (`DistanceFog`): aplicada DENTRO do shader do material —
    // sem ela o terreno por layers lia o horizonte a 100% de contraste, as
    // transições de LOD ao longe ficavam duras e o pop-in de chunks era
    // visível. A ordem é a do pipeline: fog antes do tone mapping (nó de
    // pós-processo no 0.19 — TONEMAP_IN_SHADER não está definido aqui).
    out.color = main_pass_post_lighting_processing(pbr_input, out.color);
    return out;
}
