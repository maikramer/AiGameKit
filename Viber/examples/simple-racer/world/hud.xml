<?xml version="1.0" encoding="UTF-8"?>
<world>
  <UiStyle src="ui/race.css" />
  <UiRoot id="race-hud" script="ui/race_hud.lua">
    <!-- Topo-direita: volta, posição, cronómetros. -->
    <UiColumn class="anchor-race-top">
      <UiPanel class="hud-card race-card">
        <UiRow class="race-line">
          <UiText class="race-label">VOLTA</UiText>
          <UiSpacer />
          <UiText id="race-lap" class="race-value">1/3</UiText>
        </UiRow>
        <UiRow class="race-line">
          <UiText class="race-label">POSIÇÃO</UiText>
          <UiSpacer />
          <UiText id="race-pos" class="race-value">5/5</UiText>
        </UiRow>
        <UiRow class="race-line">
          <UiText class="race-label">TEMPO</UiText>
          <UiSpacer />
          <UiText id="race-time" class="race-time">0:00.0</UiText>
        </UiRow>
        <UiRow class="race-line">
          <UiText class="race-label">MELHOR</UiText>
          <UiSpacer />
          <UiText id="race-best" class="race-time">—</UiText>
        </UiRow>
      </UiPanel>
    </UiColumn>

    <!-- Toast de power-up (item boxes escrevem aqui). -->
    <UiColumn class="anchor-toast">
      <UiPanel id="item-toast-panel" class="toast">
        <UiText id="item-toast" class="toast-text"></UiText>
      </UiPanel>
    </UiColumn>

    <!-- Fundo-esquerda: hint de controlos (sempre visível). -->
    <UiColumn class="anchor-hint">
      <UiPanel class="hint">
        <UiText class="hint-text">W/S acelera · A/D vira · SPACE drift · SHIFT nitro · R reinicia</UiText>
      </UiPanel>
    </UiColumn>

    <!-- Fundo-direita: speedómetro + nitro. -->
    <UiColumn class="anchor-speedo">
      <UiPanel class="hud-card speedo">
        <UiRow class="speed-line" align="end" justify="end">
          <UiText id="speed-kmh" class="speed-num">0</UiText>
          <UiText class="speed-unit">km/h</UiText>
        </UiRow>
        <UiBar id="nitro-bar" class="track nitro" value="0.5" />
        <UiText class="nitro-label">NITRO [SHIFT]</UiText>
      </UiPanel>
    </UiColumn>

    <!-- Centro: banners (countdown, GO, mensagens, wrong way). -->
    <UiColumn class="anchor-banner">
      <UiPanel id="banner" class="banner">
        <UiText id="banner-text" class="banner-text"></UiText>
      </UiPanel>
    </UiColumn>
  </UiRoot>
</world>
