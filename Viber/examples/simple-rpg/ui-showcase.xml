<?xml version="1.0" encoding="UTF-8"?>
<world clear-color="#1b2432" static="true">
  <Sky sun-size="1.4" />
  <DayCycle minute-of-day="540" minutes-per-real-second="4" />
  <Terrain world-size="256" max-height="18" seed="7" heightmap="ui-showcase.data/terrain.ahgt" />
  <UiStyle src="ui/showcase.css" />
  <UiRoot id="showcase" script="ui/showcase.lua">
    <UiColumn id="stage" class="stage">
      <UiText id="heading" class="heading">UI Showcase</UiText>
      <UiGrid id="inv" class="inv" cols="repeat(5, 44)" rows="repeat(2, 44)">
        <UiPanel class="slot" tooltip="Espada curta — dano 8">
          <UiText class="slot-glyph">S</UiText>
        </UiPanel>
        <UiPanel class="slot rare" tooltip="Arco élfico — item RARO">
          <UiText class="slot-glyph">A</UiText>
        </UiPanel>
        <UiPanel class="slot" tooltip="Poção (12)">
          <UiIcon class="slot-icon" src="/assets/icons/icon_potion.png" />
        </UiPanel>
        <UiPanel class="slot" tooltip="Poção de antídoto">
          <UiIcon class="slot-icon" src="/assets/icons/icon_antidote.png" />
        </UiPanel>
        <UiPanel class="slot empty" tooltip="Vazio — arrasta itens para aqui" />
        <UiPanel class="slot" tooltip="Ouro">
          <UiIcon class="slot-icon" src="/assets/icons/hud_gold.png" />
        </UiPanel>
        <UiPanel class="slot" tooltip="Madeira">
          <UiIcon class="slot-icon" src="/assets/icons/hud_wood.png" />
        </UiPanel>
        <UiPanel class="slot" tooltip="Pedra">
          <UiIcon class="slot-icon" src="/assets/icons/hud_stone.png" />
        </UiPanel>
        <UiPanel class="slot legendary" tooltip="Item LENDÁRIO">
          <UiText class="slot-glyph">!</UiText>
        </UiPanel>
        <UiPanel class="slot empty" tooltip="Vazio" />
      </UiGrid>
      <UiColumn class="group">
        <UiCheck id="check-hud" class="check" value="1">
          <UiPanel class="check-box">
            <UiPanel class="tick" />
          </UiPanel>
          <UiText class="check-label">Mostrar HUD</UiText>
        </UiCheck>
        <UiCheck id="check-anim" class="check" value="1">
          <UiPanel class="check-box">
            <UiPanel class="tick" />
          </UiPanel>
          <UiText class="check-label">Animação do selo</UiText>
        </UiCheck>
        <UiCheck id="check-sfx" class="check">
          <UiPanel class="check-box">
            <UiPanel class="tick" />
          </UiPanel>
          <UiText class="check-label">Som ambiente</UiText>
        </UiCheck>
      </UiColumn>
      <UiColumn class="group">
        <UiRow class="slider-line">
          <UiText class="slider-label">Volume</UiText>
          <UiSlider id="volume" class="slider" min="0" max="100" step="5" value="70">
            <UiText class="slider-readout">70</UiText>
          </UiSlider>
        </UiRow>
      </UiColumn>
      <UiColumn class="group">
        <UiText class="label">Nome do herói</UiText>
        <UiInput id="hero-name" class="input" placeholder="Escreve aqui…" max-length="16" />
      </UiColumn>
      <UiColumn class="group">
        <UiBar id="bar-xp" class="track" bind="xp" value="0.62" />
        <UiRow class="slots">
          <UiCooldown id="cd-a" class="slot" bind="cd.dash" value="0">
            <UiIcon class="glyph" src="/assets/icons/glyph_dash.png" />
          </UiCooldown>
          <UiCooldown id="cd-b" class="slot" bind="cd.heal" value="0">
            <UiIcon class="glyph" src="/assets/icons/glyph_heal.png" />
          </UiCooldown>
          <UiPanel id="seal" class="seal" anim="spin 6" tooltip="Selo em rotação — `anim=`">
            <UiText class="seal-glyph">V</UiText>
          </UiPanel>
        </UiRow>
      </UiColumn>
      <UiColumn class="group">
        <UiPanel id="banner" class="banner" bind="demo.gradiente:on-tag">
          <UiText class="banner-text">gradiente + transição</UiText>
        </UiPanel>
        <UiRow class="slots">
          <UiButton id="demo-btn" class="demo-btn" tooltip="hover suave por `transition`">
            <UiText>hover em mim</UiText>
          </UiButton>
          <UiPanel id="danger-demo" class="danger-demo" tooltip="@keyframes danger-pulse em loop">
            <UiText class="slot-glyph">!</UiText>
          </UiPanel>
        </UiRow>
      </UiColumn>
      <UiColumn id="dynamic-area" class="group dynamic">
        <UiText class="label">Área dinâmica (create/destroy por script):</UiText>
      </UiColumn>
    </UiColumn>
    <UiColumn id="readout" class="readout">
      <UiText id="readout-text" class="readout-text">—</UiText>
    </UiColumn>
    <UiModal id="demo-menu" key="m" class="overlay">
      <UiColumn class="frame">
        <UiRow class="tabbar">
          <UiButton class="tab" tab-group="demo" tab="quests">
            <UiText>Missões</UiText>
          </UiButton>
          <UiButton class="tab" tab-group="demo" tab="bag">
            <UiText>Mochila</UiText>
          </UiButton>
        </UiRow>
        <UiColumn class="page" tab-group="demo" tab="quests" scroll="y">
          <UiList id="demo-quests" class="rows" bind="quests">
            <UiTemplate>
              <UiRow id="row-{index}" class="row {status}">
                <UiText class="row-title">{title}</UiText>
                <UiText class="row-count">{progress_text}</UiText>
              </UiRow>
            </UiTemplate>
            <UiEmpty>
              <UiText class="empty">Sem missões.</UiText>
            </UiEmpty>
          </UiList>
        </UiColumn>
        <UiColumn class="page" tab-group="demo" tab="bag" scroll="y">
          <UiList id="demo-bag" class="rows" bind="bag-demo">
            <UiTemplate>
              <UiRow class="row">
                <UiText class="row-title">{name}</UiText>
                <UiText class="row-count">×{count}</UiText>
              </UiRow>
            </UiTemplate>
            <UiEmpty>
              <UiText class="empty">Mochila vazia.</UiText>
            </UiEmpty>
          </UiList>
        </UiColumn>
      </UiColumn>
    </UiModal>
  </UiRoot>
</world>
