<world>
  <!--
  Discordia district fragment. Loaded via Include from cities/discordia.xml.
  Artérias cobble → paths/network.xml (<RoadNetwork>). Aqui: só pad da praça.
  Layout compacto: praça 32×32 → 20×20 (muralha ±39.8). Continua a ser a maior
  área aberta da cidade — o que encolheu foi o vazio entre distritos.
-->
  <Group name="city.roads" translation="0 0 0">
    <Group translation="0 0 0" body="fixed" collider="none">
      <!-- Decal da praça: cobblestone 4 m/tile (a migração derrubou o
           texture-url original; a engine agora suporta texture em
           primitivas). base-color neutro para casar com as ribbons. -->
      <Plane translation="0 0.05 0" half-size="10 10" texture="/assets/textures/cobblestone_road.png" texture-tile-size="4" base-color="#9d9891" roughness="0.9" />
    </Group>
  </Group>
</world>
