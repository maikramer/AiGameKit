<!--
  Migrated from VibeGame by scripts/migrate_from_vibegame.py; tags não
  implementadas passam verbatim e fazem no-op na engine.
  Dropped attrs: ambient-light:ground-color, directional-light:cast-shadow, directional-light:distance, directional-light:pcss, directional-light:shadow-map-size, postprocessing
  Verbatim (no-op) tags: AdaptiveQuality x1, AudioMixer x1, DayCycle x1, MusicLayer x6, Sky x1, WorldBorder x1
  Live tags (consumed by the engine): BiomeRegion x4 (display-name alimenta o HUD), Weather x1
  (rain="0" + cycle="1": o scheduler rola chuva determinística por seed a cada 240 s)
-->
<world>
  <!--
  World fragment loaded via Include src= (see index.html shell).
  Edit this file — do not paste into index.html.
  Cell coords for CityGrid: space-separated (at="4 2").
-->
  <Group name="environment" translation="0 0 0">
    <!-- ============================================================
           §0 CÉU, LUZ, PÓS-PROCESSAMENTO E ÁUDIO
           Pipeline moderado (stylized): sombras PCSS 1024, SSAO + bloom +
           fog/grading. DoF / god-rays / film-grain OFF (custo alto, pouco
           ganho em jogabilidade). SSR OFF (águas usam mirror planar).
           AdaptiveQuality pode baixar DPR até 0.55 sob pressão; teto 1.5
           (nativo) quando a dGPU está no jogo.
           ============================================================ -->
    <!-- Céu atmosférico procedural (espalhamento de Preetham + nuvens no
             shader + disco solar): o sol definido aqui dirige a direcional
             abaixo e o PMREM vira `scene.environment` — céu, sombras e o
             ambient PBR compartilham um único sol. O equirect painterly
             (sky.png) fica disponível em /assets/sky/ para quem preferir
             céu de imagem (`<EquirectSky>`). Nuvens do shader ficam leves
             porque os billboards do Weather (crossfade por bioma) são a
             camada de nuvens "de jogo". -->
    <!-- Calendário dia/noite: o <DayCycle> escreve a elevação/azimute do
              <Sky> (quantizados a 2°) e faz o ramp da luz ambiente
              (0.26 de dia — o look atual — para 0.10 à noite: LOOP C baixou
              de 0.13 — com as ~70 luzes da vila (cadência LOOP C nas
              estradas + braseiros + janelas) o chão já lê pelas PRÓPRIAS
              lanternas, e o ambiente alto esmagava a hierarquia: poças e
              chamas não destacavam contra um chão meio-cinza. 0.10 mantém o
              chão ao luar legível e devolve o contraste às fontes quentes).
              A luz direcional não segue o sol abaixo do horizonte — vira
              lua (ver `worldsys.rs`). Dia de 20 min reais; começa 08:00. -->
    <DayCycle minute-of-day="480" minutes-per-real-second="1.2" dawn-minute="330" dusk-minute="1170" sun-azimuth-base="205" max-sun-elevation="62" drive-ambient="1" ambient-day-intensity="0.26" ambient-night-intensity="0.075" />
    <Sky sun-elevation="17" sun-azimuth="205" turbidity="2.4" rayleigh="2.8" mie-coefficient="0.0035" mie-directional-g="0.80" cloud-coverage="0.60" cloud-density="0.55" cloud-elevation="0.55" environment-intensity="0.38" sun-intensity="2.6" drive-light="1" />
    <!-- Ambiente hemisférico baixo: o IBL do céu é quem colore a sombra
           (azul de céu em cima, quente do chão embaixo); biomas continuam a
           crossfadar o ambient por região. Sombras 2048 + PCSS (penumbra que
           abre com a distância ao bloqueador). Height fog com perspectiva
           aérea + inscattering do sol; as densidades por bioma abaixo
           continuam a aplicar-se (o efeito lê o componente a cada frame).
           ACES dá o contraste que o AgX lavava; bloom só no sol/glare
           (threshold 8 — o céu procedural é HDR). -->
    <Entity>
      <DirectionalLight />
      <AmbientLight color="0xc8d8e8" brightness="110" />
    </Entity>
    <!-- Adaptive Quality: target 60; max 1.0 = resolução nativa na dGPU.
             Em iGPU/PRIME mal configurado o piso 0.55 ainda protege FPS. -->
    <AdaptiveQuality target-fps="60" min-pixel-ratio="0.55" max-pixel-ratio="1.5" />
    <!-- Fronteira suave, perto do fim do mapa (terreno ±2000): a serra
             fecha o horizonte na crista (~560) e o lado de lá desce até à
             orla. Cruzar r=1800 conta 5 s no ecrã e devolve o herói ao ponto
             mais próximo DENTRO da fronteira, assente no chão e sem
             velocidade — em vez de cair do mundo no corte final. -->
    <WorldBorder radius="1800" warn-seconds="5" margin="80" />
    <!-- Mixer buses + BGM layers. O MusicLayerDriverSystem (engine)
             crossfada por contexto (main.ts bgmZone): boss > battle (aggro) >
             dungeon (interiores) > mountain (Picos Gelados) > village (muralha)
             > explore. Todas saem na bus 'music' controlada pelo slider. Clips
             do pool partilhado (shared-assets/public/assets/audio). -->
    <AudioMixer master="1" music="0.7" sfx="0.8" />
    <MusicLayer layer="explore" sound="bgm-explore" base-volume="0.18" />
    <MusicLayer layer="battle" sound="bgm-battle" base-volume="0.22" />
    <MusicLayer layer="boss" sound="bgm-boss" base-volume="0.24" />
    <MusicLayer layer="dungeon" sound="bgm-dungeon" base-volume="0.2" />
    <MusicLayer layer="mountain" sound="bgm-mountain" base-volume="0.2" />
    <MusicLayer layer="village" sound="bgm-village" base-volume="0.18" />
    <!-- Clima global: vento constante de SW, nuvens com ciclo lento
           (cobertura "respira" ao longo de minutos), chuva controlada por
           bioma (pântano) ou via setWeather() em runtime. -->
    <Weather wind="0.7 0.25" wind-strength="1.5" clouds="0.25" rain="0" cycle="1" />
    <!-- ============================================================
           §1 BIOMAS — 4 cunhas cardeais. Tint/fog/exposure por região
           (consumidos pela engine); o herói entra e a zona aplica-se.
           As cunhas começam fora do quadrado central (±56) e são
           partidas pelas diagonais — sem sobreposição; a cidade fica
           como vale neutro. Os cantos do sul foram de ±240 porque a
           câmera passou a ver até 420 m: com menos, a serra da borda
           ficava fora de qualquer bioma e perdia tint/fog.
           ============================================================ -->
    <!-- NORTE: Floresta Sombria. `display-name` alimenta o bind `zone.name`
         (HUD): nome autoral vence a tabela de fallback da engine. -->
    <BiomeRegion id="dark-forest" display-name="Floresta Sombria" polygon="[-56,56;56,56;4040,4040;-4040,4040]" tint="#1a3320" fog-density="0.0020" pp-exposure="0.78" />
    <!-- LESTE: Deserto -->
    <BiomeRegion id="desert" display-name="Ermo Rubro" polygon="[56,-56;56,56;4040,4040;4040,-4040]" tint="#c2a878" fog-density="0.0014" pp-exposure="0.74" pp-bloom-strength="0.18" />
    <!-- OESTE: Pântano (bacias baixas do relevo real) -->
    <BiomeRegion id="swamp" display-name="Pântano da Bruma" polygon="[-56,-56;-56,56;-4040,4040;-4040,-4040]" tint="#3a4a30" fog-density="0.0046" pp-exposure="0.70" />
    <!-- SUL: Picos Gelados. Vértice da cunha empurrado de ±56 para ±240:
             o setor sul só ganha cota a partir de r≈260 (126 m a 80-160 m,
             161 m a 400-600 m). Com o vértice na muralha, a textura de neve
             começava a 60 m do portão, em pleno fundo de vale. Entre a
             cidade e r=240 fica o anel neutro do vale. -->
    <BiomeRegion id="frozen-peaks" display-name="Picos Gelados" polygon="[-240,-240;240,-240;4040,-4040;-4040,-4040]" tint="#cdd9e6" fog-density="0.0014" pp-exposure="0.78" />
  </Group>
  <!-- FIM environment -->
</world>
