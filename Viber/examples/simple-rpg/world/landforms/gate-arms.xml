<!--
  OS BRAÇOS DO PORTÃO — embutir Discordia no terreno (loop D-terreno).

  PORQUÊ: a vila assenta num pad 120×120 ( Gameplay: praça plana — fica)
  mas os APROCHES eram relva morta até ao horizonte: quem saía pelo portão
  N andava num tapete plano entre nada. BotW embute as povoações — a
  estrada abre-se entre braços de rocha, um ombro por trás da capela,
  um outeiro com banco donde ver o conjunto.

  Este ficheiro acrescenta:
    §1  braço OESTE do portão N — parede côncava 9 m a oeste da artéria
        (36-50 m do eixo), do laguinho à altura do celeiro;
    §2  ombro da CAPELA — cadeia convexa→côncava a NE da muralha
        (x 30-46), 5→9 m: a capela (10,25) passa a ter "rocha por trás";
    §3  o OUTEIRO DA NOTA — pad 20×20 a 50 m (terreno natural ~45) com
        banco + cairn, 105 m a SSO da praça: dali vê-se praça → muralha →
        massiço N com a Torre Quebrada (rampart.xml §2) em camadas.
        O espigão de terra (flatten="0") liga a artéria S ao outeiro.

  MEDIÇÕES (tools/height_probe.py):
    (0,30) 39.5 m 4.8°   praça/pad (40 m no centro, pad 120×120 falloff 20)
    (±45,90) 43-44 m     aproche N suave — os braços assentam aqui
    (30,-104) ~45 m      ombria S já a subir para os picos (94 m em -200)

  FACES (`side` = esquerda do sentido do path): braço O com path para N →
  face Este (side="right"); ombro da capela path para N → face Oeste
  (side="left"). Guardas: artéria N no eixo x≈0..-3 (30+ m de folga);
  laguinho NW (-80,104 r16) a 13 m da banda Oeste; trilha do lenhador
  (z=128) N dos campos.
-->
<world>
  <Group name="landforms.gate-arms" translation="0 0 0">
    <!-- ============================================================
       §1 BRAÇO OESTE — a parede alta do corredor: 9 m de côncava com
       escorrimentos, do portão até ~112 m.
       ============================================================ -->
    <Cliff name="braco-oeste" path="-36 66 -42 90 -47 112"
           width="7" height="9" profile="concave" side="right"
           noise="0.25" seed="81" gullies="0.2" talus="1" />

    <!-- ============================================================
       §2 OMBRO DA CAPELA — dois lances: rampa convexa baixa (5 m) e
       depois o ressalto côncavo (9 m) que fecha o NE da vila.
       ============================================================ -->
    <Cliff name="ombro-capela-baixo" path="30 54 36 66 41 82"
           width="6" height="5" profile="convex" side="left"
           noise="0.3" seed="82" talus="1" />
    <Cliff name="ombro-capela-alto" path="41 82 45 98 43 116"
           width="8" height="9" profile="concave" side="left"
           noise="0.25" seed="83" gullies="0.18" talus="1" />

    <!-- ============================================================
       §3 OUTEIRO DA NOTA — o miradouro. Pad a 50 m (natural ~45, vila
       40): +10 m sobre a praça, encosta suave (falloff 16). Espigão de
       terra desde a artéria S. Banco de cara à vila e cairn de marco.
       ============================================================ -->
    <TerrainPad at="30 -104" size="20 20" falloff="16" corner-radius="9" height="50" />
    <SpawnExclusion at="30 -104" radius="10" />
    <Road path="2 -92 12 -97 21 -102" width="2" flatten="0" texture-scale="4"
          edge-feather="1.2" texture-url="/assets/textures/dirt/albedo.ktx2"
          normal-map-url="/assets/textures/dirt/normal.ktx2" />
    <!-- Banco voltado para a vila (NO do outeiro) + cairn marco. -->
    <Entity name="outeiro-banco" translation="26.5 0 -100.5" transform="rotation: 0 -125 0"
            rigidbody="type: fixed; mass: 0; gravity-scale: 0" collider="shape: box; size: 1.6 0.9 0.55">
      <GltfScene url="/assets/meshes/village/wooden_bench_lod0.glb" />
    </Entity>
    <Entity name="outeiro-cairn" translation="33.5 0 -101" transform="rotation: 0 30 0"
            rigidbody="type: fixed; mass: 0; gravity-scale: 0" collider="shape: trimesh; mesh-url: /assets/meshes/terrain/form_stack_6_collision.glb; mesh-anchor: base">
      <GltfScene url="/assets/meshes/terrain/form_stack_6_lod0.glb" />
    </Entity>
  </Group>
  <!-- FIM landforms.gate-arms -->
</world>
