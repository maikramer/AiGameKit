<!--
  Migrated from VibeGame by scripts/migrate_from_vibegame.py; tags não
  implementadas passam verbatim e fazem no-op na engine.
  Verbatim (no-op) tags: RoadNetwork x1
-->
<world>
  <!--
  Rede cobble interligada (não só cruz +).
  - flatten-max-grade=0.34 (≈19°) e flatten-window=72: com o relevo cru do
    Terrain3D as artérias sobem encostas de 13-20° (o setor leste vai de 134 m
    no vale a 165 m). Com o antigo 0.22 (12.4°) o `limitProfileGrade` prendia
    o perfil abaixo do terreno e o carve tinha de abrir uma trincheira mais
    funda do que o falloff alcança — a estrada ficava numa vala de paredes
    verticais. Deixar a estrada seguir a encosta é mais barato e lê-se melhor.
  - Cruz praça → mid_* (grau 4) → portões / biomas
  - Anel periurbano mid_n→ne→mid_e→se→mid_s→sw→mid_w→nw→mid_n
    (T nos mid_* = cruzamentos programáticos)
  - Travessia de água: `<Bridge>` volumétrica, uma por ficheiro em
    world/bridges/ — Ponte de Pedra do Norte (n_bank↔n_resume, centrada
    no eixo x=4 do rio). O antigo Segment profile=bridge desenhava ribbon
    plana SEM collider — no terreno voxel o herói não tinha atravessia; o
    vão não tem segmento: o tabuleiro voxel É a travessia. A Lagoa Grande
    NÃO se atravessa: a artéria contorna-a por terra (margem norte — o
    contorno lê-se melhor que um viaduto no canto da lagoa).
  - via= nos Segments longos (docks de trails.xml)
-->
  <Group name="paths.network" translation="0 0 0">
    <RoadNetwork default-profile="artery" default-width="4" crossing-flare="true" flatten="true" flatten-falloff="26" flatten-window="72" flatten-max-grade="0.34" texture-url="/assets/textures/cobblestone_road/albedo.ktx2" normal-map-url="/assets/textures/cobblestone_road/normal.ktx2" texture-scale="9">
      <!-- Praça + docks do anel (muralha ±39.8 — layout compacto).
         mid_* ficam 8 m dentro da muralha, alinhados com os portões. -->
      <Way id="plaza" xz="0 0" width="4.8" />
      <Way id="mid_n" xz="0 32" />
      <Way id="mid_e" xz="32 0" />
      <Way id="mid_s" xz="0 -32" />
      <Way id="mid_w" xz="-32 0" />
      <!-- Cantos do anel -->
      <Way id="ring_ne" xz="25 25" />
      <Way id="ring_se" xz="25 -25" />
      <Way id="ring_sw" xz="-25 -25" />
      <Way id="ring_nw" xz="-25 25" />
      <!-- Cabeças do desvio da Lagoa Grande (pântano, lagoa -190,-16
         r=24): eram as cabeças da antiga ponte-ribbon; hoje delimitam o
         desvio por terra da artéria (margem norte). Ficam a ~36 m do
         centro — fora do WORST-CASE do contorno orgânico (24 × 1.45 =
         34.8 m; LakeShape por lago, AGENTS.md §Lake). -->
      <Way id="w_lake_e" xz="-163.9 9" />
      <Way id="w_lake_w" xz="-215.7 9.5" />
      <!-- Norte (floresta) — as pontas do Viaduto de Pedra do Norte
         (world/bridges/ponte-norte.xml): a sul a ribbon TERMINA LONGE da
         água (z 175) — o falloff do carve (26 m) wrap para além do fim da
         estrada e, terminando perto do rio, erguia um esporão de terra
         até ao guard de água (corte a pique no rio); o TABULEIRO cobre
         175→242 (nível + rampa). A norte z 240, no pad-pino. -->
      <Way id="n_gate" xz="-3 128" />
      <Way id="n_bank" xz="4 175" />
      <Way id="n_resume" xz="4 240" />
      <Way id="n_end" xz="-8 286" />
      <!-- Sul (picos gelados) — sem rio, artéria contínua -->
      <Way id="s_end" xz="-12 -286" />
      <!-- Este (deserto) -->
      <Way id="gate_e" xz="124 2" />
      <Way id="desert_end" xz="290 -4" />
      <!-- Oeste (pântano) — sem rio, artéria contínua; a Lagoa Grande é
         contornada por terra na margem norte (via em w_lake_e↔w_lake_w). -->
      <Way id="w_end" xz="-292 12" />
      <!-- Cruzamento praça → mid (grau 4 em cada mid com anel) -->
      <Segment a="plaza" b="mid_n" via="0 5 0 19" profile="plaza" />
      <Segment a="plaza" b="mid_s" via="0 -5 0 -19" profile="plaza" />
      <Segment a="plaza" b="mid_e" via="5 0 19 0" profile="plaza" />
      <Segment a="plaza" b="mid_w" via="-5 0 -19 0" profile="plaza" />
      <!-- Artérias além do anel -->
      <Segment a="mid_n" b="n_gate" via="0 60 -2 96" />
      <Segment a="n_gate" b="n_bank" via="0 152 2 168" />
      <!-- O vão do rio (n_bank↔n_resume) NÃO é segmento: a travessia é a
         `<Bridge>` volumétrica em world/bridges/ponte-norte.xml — o
         antigo Segment profile=bridge desenhava uma ribbon plana sem
         collider e o audit passou a marcá-la como travessia quebrada. -->
      <Segment a="n_resume" b="n_end" via="2 252 -4 270" />
      <Segment a="mid_s" b="s_end" via="0 -58 2 -84 0 -184 18 -220" />
      <Segment a="mid_e" b="gate_e" via="60 0 96 2" />
      <Segment a="gate_e" b="desert_end" via="160 6 200 10 240 8" />
      <Segment a="mid_w" b="w_lake_e" via="-58 0 -80 -2" />
      <!-- Desvio por terra da Lagoa Grande (margem norte): o arco passa a
         ≥45 m do centro da lagoa (-190,-16) — o worst-case do contorno é
         34.8 m, portanto a artéria nunca entra na bacia. O trilho da
         margem (paths/trails.xml) arranca no via -192 32 e desce ao
         acampamento do pescador. -->
      <Segment a="w_lake_e" b="w_lake_w" via="-174 26 -192 32 -206 27" />
      <Segment a="w_lake_w" b="w_end" />
      <!-- Anel periurbano (liga os quatro mid_*) -->
      <Segment a="mid_n" b="ring_ne" via="11 32 20 29" />
      <Segment a="ring_ne" b="mid_e" via="29 20 32 11" />
      <Segment a="mid_e" b="ring_se" via="32 -11 29 -20" />
      <Segment a="ring_se" b="mid_s" via="20 -29 11 -32" />
      <Segment a="mid_s" b="ring_sw" via="-11 -32 -20 -29" />
      <Segment a="ring_sw" b="mid_w" via="-29 -20 -32 -11" />
      <Segment a="mid_w" b="ring_nw" via="-32 11 -29 20" />
      <Segment a="ring_nw" b="mid_n" via="-20 29 -11 32" />
    </RoadNetwork>
    <!-- As pontes volumétricas NÃO vivem aqui: uma por ficheiro em
       world/bridges/ (ponte-norte, ponte-lagoa-grande e as passadeiras
       naturais da floresta), incluídas no world.xml a seguir a
       paths/trails.xml. -->
  </Group>
  <!-- FIM paths.network -->
</world>
