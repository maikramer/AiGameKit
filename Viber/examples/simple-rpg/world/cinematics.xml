<?xml version="1.0" encoding="UTF-8"?>
<world static="true">
  <Cinematic id="prologo" skippable="true" letterbox="true">
    <Fade at="0" duration="2.2" from="1" to="0" />
    <Sound at="0.4" clip="notification" />
    <Shot duration="8" from="170 140 230" to="115 105 150" look="0 38 0" look-to="0 40 -5" ease="in-out" />
    <Title at="1.8" duration="5" sub="Capítulo I · A Nota">O Silêncio de Vael</Title>
    <Line at="7.6" duration="4.4" speaker="Ancião Edmar">Há trinta invernos que o Coro de Vael não canta.</Line>
    <Shot duration="7" from="950 230 860" to="925 216 830" look="888 197 782" look-to="888 199 782" ease="in-out" />
    <Line at="12.1" duration="4.6" speaker="Ancião Edmar">Lá em cima, no Alto, os cristais cantavam — e enquanto cantavam, a bruma ficava no pântano e os bichos nos covis.</Line>
    <Shot duration="6.5" from="-790 214 -330" to="-800 206 -300" look="-870 190 -240" look-to="-860 191 -245" ease="in-out" />
    <Line at="16.8" duration="4.8" speaker="Ancião Edmar">Até a Cidadela cair numa só noite. O canto partiu-se em quatro Notas, e quatro criaturas engoliram-nas.</Line>
    <Shot duration="7.5" anchor="player" from="6 3.2 8" to="2.6 2.1 4.2" look="0 1.5 0" look-to="0 1.6 0" ease="out" />
    <Line at="21.8" duration="4.2" speaker="Ancião Edmar">Tu vieste medir a terra, cartógrafo. Mede-a bem — e encontra-as.</Line>
    <Line at="26.1" duration="2.9" speaker="Ancião Edmar">Procura-me no salão comunal.</Line>
  </Cinematic>
  <Cinematic id="guardiao-bruxa" skippable="true">
    <Sound at="0.2" clip="boss_roar" />
    <Shot duration="3" anchor="self" from="7 2.2 7" to="4.5 3.2 4.5" look="0 1.8 0" look-to="0 2.0 0" ease="out" />
    <Shot duration="3.6" anchor="self" from="-2.5 1.0 5.5" to="-3.5 1.3 4.6" look="0 2.3 0" ease="in-out" />
    <Title at="0.6" duration="3.2" sub="Guardiã da Nota do Bosque">A Bruxa do Bosque</Title>
    <Line at="3.2" duration="3.4" speaker="Irmã Vessa">Quando ela apontar o chão onde pisas, sai. A maldição cai no mesmo sítio.</Line>
  </Cinematic>
  <Cinematic id="guardiao-verme" skippable="true">
    <Sound at="0.1" clip="boss_roar" />
    <Shot duration="3.2" anchor="self" from="10 1.5 9" to="6 4.5 6" look="0 1.2 0" look-to="0 2.2 0" ease="out" />
    <Shot duration="3.4" anchor="self" from="0 7 -8" to="2 6 -7" look="0 1.5 0" ease="in-out" />
    <Title at="0.6" duration="3.2" sub="Guardião da Nota do Ermo">O Verme do Ermo</Title>
    <Line at="3.3" duration="3.3" speaker="Kadi">Quando a areia tremer à volta dele, corre para longe do círculo.</Line>
  </Cinematic>
  <Cinematic id="guardiao-lodo" skippable="true">
    <Sound at="0.2" clip="boss_roar" />
    <Shot duration="3.2" anchor="self" from="6 1.0 -8" to="4 2.4 -5" look="0 1.6 0" look-to="0 2.0 0" ease="out" />
    <Shot duration="3.4" anchor="self" from="-6 3.5 3" to="-5 3.0 4" look="0 1.8 0" ease="in-out" />
    <Title at="0.6" duration="3.2" sub="Guardião da Nota do Lodo">O Que Conta os Afogados</Title>
    <Line at="3.3" duration="3.3" speaker="Onno">O lago leva tudo. Não fiques parado na lama quando ele se erguer.</Line>
  </Cinematic>
  <Cinematic id="guardiao-ogro" skippable="true">
    <Sound at="0.15" clip="boss_roar" />
    <Shot duration="3.2" anchor="self" from="3 0.8 9" to="2 1.6 6" look="0 3.0 0" look-to="0 3.4 0" ease="out" />
    <Shot duration="3.4" anchor="self" from="9 6 0" to="7 5 -3" look="0 2.0 0" ease="in-out" />
    <Title at="0.6" duration="3.2" sub="Guardião da Nota dos Picos">O Ogro dos Picos</Title>
    <Line at="3.3" duration="3.3" speaker="Batedora Sig">Quando ele erguer os punhos, sai de perto antes que a terra rache.</Line>
  </Cinematic>
  <Cinematic id="nota" skippable="true">
    <Sound at="0.1" clip="level_up" />
    <Shot duration="5.4" anchor="player" from="4 1.6 4" to="-3 3.4 4.5" look="0 1.4 0" look-to="0 1.7 0" ease="in-out" />
    <Title at="0.4" duration="3.4" sub="O Coro lembra-se de mais uma voz">Nota recuperada</Title>
    <Line at="2.6" duration="2.8" speaker="Ancião Edmar">Senti-a daqui, cartógrafo. Traz-ma ao salão comunal.</Line>
  </Cinematic>
  <Cinematic id="campo-de-batalha" skippable="true">
    <Fade at="0" duration="1" from="1" to="0" />
    <Shot duration="6" from="-740 200 -300" to="-752 197 -285" look="-774 191 -270" ease="in-out" />
    <Shot duration="6" from="-800 196 -250" to="-790 195 -262" look="-870 192 -240" ease="in-out" />
    <Title at="0.8" duration="3.4" sub="Onde a coluna parou">O Campo de Batalha</Title>
    <Line at="3.6" duration="4.2" speaker="Veterano do Campo">Subimos de noite para defender a Cidadela. Ao amanhecer já não havia Cidadela para defender.</Line>
    <Line at="8" duration="4" speaker="Veterano do Campo">As sombras que vês têm os rostos dos meus. Dá-lhes descanso.</Line>
  </Cinematic>
  <Cinematic id="epilogo" skippable="true">
    <Fade at="0" duration="1.2" from="1" to="0" />
    <Sound at="0.5" clip="level_up" />
    <Shot duration="7" anchor="player" from="3 2 4" to="1.5 4 6" look="0 1.5 0" look-to="0 3 0" ease="in-out" />
    <Line at="0.8" duration="4.2" speaker="Ancião Edmar">Quatro Notas. Há trinta invernos que não as ouvia juntas.</Line>
    <Shot duration="9" from="960 240 870" to="905 212 815" look="888 197 782" look-to="888 200 782" ease="in-out" />
    <Line at="7.6" duration="4.4" speaker="Ancião Edmar">Escuta. Lá em cima, no Alto… o Coro canta outra vez.</Line>
    <Title at="12.2" duration="3.6" sub="O Silêncio de Vael terminou">O Coro canta outra vez</Title>
    <Shot duration="6" from="140 120 200" to="90 95 140" look="0 38 0" ease="in-out" />
    <Title at="16.6" duration="4.6" sub="O Vale continua à tua espera">Fim do Capítulo I</Title>
  </Cinematic>
</world>
