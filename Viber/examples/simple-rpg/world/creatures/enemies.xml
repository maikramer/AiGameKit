<!--
  Migrated from VibeGame by scripts/migrate_from_vibegame.py; tags não
  implementadas passam verbatim e fazem no-op na engine.
  Verbatim (no-op) tags: DynamicSpawner x10
-->
<world>
  <!--
  Inimigos por bioma (DynamicSpawner). Loaded via Include. Chefes em bosses.xml.

  Grounding: <Creature> = kinematic Rigidbody + capsule + CharacterController.
  Rapier CCT plants Y on the terrain chunk heightfield (same authority as player).
  NavMesh steers CharacterMovement.desiredVel (does not write Transform XZ).
  Spawn seeds Transform.posY once from the surface sample; no AABB lift /
  TerrainSpawned / script snap. goblin_collision.glb still unused (capsule CCT).

  Ao contrário dos props, cada inimigo é uma entidade com script + IA + agente
  de NavMesh — não é instanciado. Contagens sobem devagar; o DistanceCull é
  que evita pagar IA por quem está longe.

  NOTA DE ASSET: shade_*.glb não existe no bundle (só o script
  enemies/shade.ts). Enquanto não for regenerado, a sombra usa o mesh do
  bogling a 1.4× — ver public/world/context.md.
-->
  <Group name="creatures" translation="0 0 0">
    <!-- ============================================================
       NORTE — Floresta Sombria
       ============================================================ -->
    <DynamicSpawner avoid-water="1" count="10" seed="101" region-min="-170 0 124" region-max="170 0 350" random-yaw="true" avoid-overlaps="false" max-slope-deg="40" max-distance="180">
      <Creature role="enemy" script="enemies/wolf.lua">
        <GLTFLoader role="visual" url="/assets/meshes/characters/wolf_lod0.glb" lod1-url="/assets/meshes/characters/wolf_lod1.glb" lod2-url="/assets/meshes/characters/wolf_lod2.glb" lod-threshold-near="18" lod-threshold-mid="55" />
      </Creature>
    </DynamicSpawner>
    <DynamicSpawner avoid-water="1" count="8" seed="202" region-min="-170 0 160" region-max="170 0 360" random-yaw="true" avoid-overlaps="false" max-slope-deg="40" max-distance="180">
      <Creature role="enemy" script="enemies/shade.lua" transform="scale: 1.4 1.4 1.4">
        <GLTFLoader role="visual" url="/assets/meshes/characters/bogling_lod0.glb" lod1-url="/assets/meshes/characters/bogling_lod1.glb" lod2-url="/assets/meshes/characters/bogling_lod2.glb" lod-threshold-near="18" lod-threshold-mid="55" />
