<!--
  §4.4d AMPLIAÇÃO (58 AA — distrito de grelha "feito à pressa", GDD).
  Preenche o bolsão NW do anel interno (x∈[-15,-5], z∈[16..28]): o vazio
  mais visível do percurso praça→portão norte. Casa GLB da onda composition
  (porta local −X; yaw 180 → porta a este, para a artéria norte), quintal com
  lenha/barris/caixote e tocha acesa.
  Bolsão medido contra: carvalho (-13,11), house_b (-19,19), shepherd (-21,8),
  capela (10,25), corredor da artéria (|x| ≤ 2.4) e anel (z ≳ 30 no trecho NW).
-->
<Group name="city.grid-district" pos="0 0 0">
  <GameObject
    name="house_grid_a"
    transform="rotation: 0 180 0"
    place="at: -10 22; align-to-terrain: 0"
    rigidbody="type: fixed; mass: 0; gravity-scale: 0"
    collider="shape: trimesh; mesh-url: /assets/meshes/village/village_house_collision.glb; mesh-anchor: base"
  >
    <GLTFLoader
      role="visual"
      url="/assets/meshes/village/village_house_lod0.glb"
      lod1-url="/assets/meshes/village/village_house_lod1.glb"
      lod2-url="/assets/meshes/village/village_house_lod2.glb"
      lod-threshold-near="70"
      lod-threshold-mid="160"
    ></GLTFLoader>
  </GameObject>

  <!-- Quintal: lenha encostada à fachada sul, barril + caixote a poente. -->
  <GameObject
    transform="rotation: 0 15 0"
    place="at: -10 17.8; align-to-terrain: 1"
    rigidbody="type: fixed; mass: 0; gravity-scale: 0"
