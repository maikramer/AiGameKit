{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "bun-types"],
    "paths": {
      "aigamekit-vibegame": ["./src/index.ts"],
      "aigamekit-vibegame/defaults": ["./src/defaults.ts"],
      "aigamekit-vibegame/animation": ["./src/plugins/animation/index.ts"],
      "aigamekit-vibegame/input": ["./src/plugins/input/index.ts"],
      "aigamekit-vibegame/orbit-camera": [
        "./src/plugins/orbit-camera/index.ts"
      ],
      "aigamekit-vibegame/physics": ["./src/plugins/physics/index.ts"],
      "aigamekit-vibegame/player": ["./src/plugins/player/index.ts"],
      "aigamekit-vibegame/rendering": ["./src/plugins/rendering/index.ts"],
      "aigamekit-vibegame/text": ["./src/plugins/text/index.ts"],
      "aigamekit-vibegame/respawn": ["./src/plugins/respawn/index.ts"],
      "aigamekit-vibegame/startup": ["./src/plugins/startup/index.ts"],
      "aigamekit-vibegame/transforms": ["./src/plugins/transforms/index.ts"],
      "aigamekit-vibegame/terrain": ["./src/plugins/terrain/index.ts"],
      "aigamekit-vibegame/bvh": ["./src/plugins/bvh/index.ts"],
      "aigamekit-vibegame/debug": ["./src/plugins/debug/index.ts"],
      "aigamekit-vibegame/profiler": ["./src/plugins/profiler/index.ts"],
      "aigamekit-vibegame/composition": ["./src/plugins/composition/index.ts"],
      "aigamekit-vibegame/group": ["./src/plugins/group/index.ts"],
      "aigamekit-vibegame/road": ["./src/plugins/road/index.ts"],
      "aigamekit-vibegame/tweening": ["./src/plugins/tweening/index.ts"],
      "aigamekit-vibegame/line": ["./src/plugins/line/index.ts"],
      "aigamekit-vibegame/vite": ["./src/vite/index.ts"],
      "aigamekit-vibegame/cli": ["./src/cli/index.ts"],
      "aigamekit-vibegame/audio/bank": ["./src/plugins/audio/bank.ts"],
      "aigamekit-vibegame/core/validation": ["./src/core/validation/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "example"]
}
