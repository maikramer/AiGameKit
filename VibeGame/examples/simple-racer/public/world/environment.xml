<!--
  Sky, light, post-processing and weather. Edit here for the look of the whole
  race — nothing in this file knows about the circuit.
-->
<Group name="environment" pos="0 0 0">
  <!-- Céu atmosférico procedural: espalhamento de Preetham com disco solar,
       nuvens no shader e IBL gerado do próprio céu (PMREM). O sol definido
       aqui dirige a direcional abaixo — céu, sombras e brilhos de pintura
       compartilham um único sol. Nuvens ficam no shader do céu (integradas ao
       gradiente), não nos billboards do Weather. -->
  <Sky
    sun-elevation="17"
    sun-azimuth="80"
    turbidity="3.2"
    rayleigh="1.9"
    mie-coefficient="0.0045"
    mie-directional-g="0.86"
    cloud-coverage="0.34"
    cloud-density="0.32"
    cloud-elevation="0.55"
    environment-intensity="0.5"
    sun-intensity="3.0"
    drive-light="1"
  ></Sky>

  <!-- Luz + pós-processamento no MESMO GameObject (é assim que a entidade
       Postprocessing nasce — o runtime só parseia o innerHTML do Scene, um
       atributo `postprocessing=` no próprio <Scene> é ignorado).
       A direcional serve de alvo do sol do <Sky>: direção, cor e intensidade
       vêm dele (drive-light); aqui ficam só os ajustes de sombra — mapa único
       4096 seguido à câmara (frustum snapped ao texel, senão a sombra
       "rasteja" a 200 km/h) + PCSS: penumbra que abre com a distância ao
       bloqueador, contacto duro debaixo do carro.
       Ambiente hemisférico baixo: o IBL do céu é quem colore a sombra (azul
       de céu em cima, quente do chão embaixo); hemisférica alta achataria.
       Tone mapping ACES (punch e contraste que o AgX lava), SSAO forte,
       height fog com perspectiva aérea + inscattering do sol. -->
  <GameObject
    ambient-light="sky-color: 0xbcd3ea; ground-color: 0x9a8a6a; intensity: 0.3"
    directional-light="cast-shadow: 1; shadow-map-size: 4096; distance: 160; pcss: 1"
    postprocessing="enabled: 1; bloom: 1; bloom-strength: 0.18; bloom-radius: 0.55; bloom-threshold: 8.0; aa: smaa; tone-mapping: aces; tone-mapping-exposure: 0.92; vignette: 1; vignette-offset: 0.30; vignette-darkness: 0.32; color-grading: 1; saturation: 0.16; contrast: 0.10; brightness: 0.0; ssao: 1; ssao-intensity: 1.45; ssao-radius: 2.2; ssr: 1; ssr-opacity: 0.55; ssr-max-distance: 70; ssr-thickness: 0.6; ssr-resolution-scale: 0.5; height-fog: 1; fog-color: 0xc9bfae; fog-density: 0.0013; fog-height: 1.5; fog-falloff: 40; fog-noise: 0.3; fog-sun-influence: 1.3; fog-sky-haze: 0.35; film-grain: 1; film-grain-opacity: 0.03; chromatic-aberration: 1; ca-strength: 0.001; god-rays: 1; god-rays-density: 0.98; god-rays-decay: 0.94; god-rays-weight: 0.45; god-rays-exposure: 0.8; depth-of-field: 0"
  >
  </GameObject>

  <!-- Qualidade adaptativa: mantém ~55 fps desenhando o pipeline HDR completo
       (SSAO/SSR/fog) — em GPU fraca cai resolução e AO antes de perder fps. -->
  <AdaptiveQuality target-fps="55"></AdaptiveQuality>

  <!-- Vento global: empurra a grama (VegetationWindSystem lê getWindVector).
       Nuvens ficam no <Sky>; weather aqui é só vento/chuva. -->
  <Weather
    wind="0.7 0.25"
    wind-strength="1.6"
    clouds="0"
    rain="0"
    cycle="1"
  ></Weather>
</Group>
