<!--
  A grelha. O `pos` de um veículo é irrelevante: o race director põe cada carro
  no seu lugar, com a orientação e a altura certas para o traçado. Em
  time-trial os `<AiVehicle>` são removidos pelo hook de mundo (src/main.ts) —
  editar os rivais aqui.

  Sem <Group>: um corpo rígido só espelha a pose no Rapier quando é top-level.
-->
<PlayerVehicle
  name="player"
  driver="You"
  color="#e03a3a"
  model-url="/assets/meshes/vehicles/kart_hero_lod0.glb"
  model-length="2.4"
  model-yaw="90"
  half-length="1.2"
  half-width="0.58"
  max-speed="52"
  accel="27"
  brake="52"
  engine-brake="7"
  max-steer="2.7"
  steer-speed="11"
  grip="7.5"
  drift-grip="0.3"
  boost="2.6"
  boost-recharge="0.28"
></PlayerVehicle>

