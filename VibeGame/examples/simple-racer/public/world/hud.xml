<!--
  Câmara de perseguição, camadas de música e HUD (incluindo o menu de pausa).
  Nada aqui depende do traçado.
-->
<ChaseCamera
  target="player"
  distance="7.6"
  height="3.1"
  follow-lag="0.1"
  turn-lag="0.15"
  look-ahead="5"
  fov="74"
  fov-boost="13"
></ChaseCamera>

<!-- BGM layers driven by the engine MusicLayerDriver (main.ts):
     bgm-race while driving, crossfade to bgm-menu over the results. -->
<MusicLayer layer="race" sound="bgm-race" base-volume="0.2"></MusicLayer>
<MusicLayer layer="menu" sound="bgm-menu" base-volume="0.18"></MusicLayer>

<HudScreenLayer>
  <HudWidget type="race-hud"></HudWidget>

  <!-- Setor à frente: mesma seta screen-space que o simple-rpg usa para
       as quests, aqui apontando o próximo checkpoint do circuito
       (CheckpointArrowSystem em main.ts). -->
  <WaypointArrow margin="64"></WaypointArrow>

  <!-- Pause menu (same TabbedModal widget as simple-rpg): [Q] opens,
       OptionsTab drives the music/sfx buses via wireOptions (main.ts). -->
  <TabbedModal
    id="pause"
    key="q"
    title-key="modal.pause"
  >
    <OptionsTab label-key="modal.tab.options" preset="core">
      <OptionRow
        id="save"
        type="button"
        label-key="options.save"
      ></OptionRow>
      <OptionRow
        id="load"
        type="button"
        label-key="options.load"
      ></OptionRow>
      <OptionRow
        id="restart"
        type="button"
        label-key="options.restart"
      ></OptionRow>
      <OptionRow
        id="controls"
        type="note"
        label-key="options.controls"
      ></OptionRow>
    </OptionsTab>
  </TabbedModal>
</HudScreenLayer>
