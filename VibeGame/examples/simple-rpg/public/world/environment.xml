<!--
  World fragment loaded via Include src= (see index.html shell).
  Edit this file — do not paste into index.html.
  Cell coords for CityGrid: space-separated (at="4 2").
-->
      <Group name="environment" pos="0 0 0">
        <!-- ============================================================
           §0 CÉU, LUZ, PÓS-PROCESSAMENTO E ÁUDIO
           Pipeline moderado (stylized): sombras PCSS 1024, SSAO + bloom +
           fog/grading. DoF / god-rays / film-grain OFF (custo alto, pouco
           ganho em jogabilidade). SSR OFF (águas usam mirror planar).
           AdaptiveQuality pode baixar DPR até 0.55 sob pressão; teto 1.0
           (nativo) quando a dGPU está no jogo.
           ============================================================ -->
        <!-- sky.png é o equirect real (2048×1024, horizonte na linha média).
             O ficheiro original do Skymap2D vinha em projeção "tiny planet"
             (o chão inteiro colapsado num disco por cima da cabeça); está
             guardado como sky_littleplanet_raw.png e a reconversão vive em
             scripts/unwarp_little_planet_sky.py.
             background-intensity 1.4 estourava o céu para branco com AgX +
             exposure 1.10 — 1.0 mantém o azul e as nuvens legíveis. -->
        <EquirectSky
          url="/assets/sky/sky.png"
          environment-intensity="0.45"
          background-intensity="1.0"
        ></EquirectSky>

        <!-- Sol baixo + ambient. Shadow 1024 + PCSS lean; CA off; SSAO
           half via AdaptiveQuality. CSM OFF (CustomShaderMaterial).

           NEVOEIRO: o fog é FogExp2 (factor = 1 - exp(-(d·ρ)²)), por isso
           satura muito mais cedo do que a intuição linear sugere. Com
           ρ=0.008 e far=840 m, tudo além de ~215 m já estava a 95 % de
           névoa: o horizonte era uma parede de leite e a serra da borda
           (400 m+) não existia. Com ρ=0.0025 a serra lê-se a ~60 % de
           névoa (silhueta) e o far continua coberto (~99 % a 840 m). As
           cunhas por baixo mantêm as suas densidades relativas — ver
           <BiomeRegion> abaixo. fog-color segue a banda do horizonte do
           equirect (#d0d6d8). -->
        <GameObject
          ambient-light="sky-color: 0xfff8f0; ground-color: 0xe0d0a8; intensity: 0.85"
          directional-light="color: 0xfff0d0; intensity: 3.2; direction-x: -0.9; direction-y: 1.2; direction-z: -0.5; cast-shadow: 0; shadow-map-size: 512; distance: 80; pcss: 0"
          postprocessing="enabled: 1; bloom: 1; bloom-strength: 0.12; bloom-radius: 0.40; bloom-threshold: 0.92; chromatic-aberration: 0; vignette: 1; vignette-offset: 0.34; vignette-darkness: 0.40; aa: fxaa; tone-mapping: agx; tone-mapping-exposure: 1.10; ssao: 0; ssao-intensity: 0.55; ssao-radius: 1.0; depth-of-field: 0; god-rays: 0; film-grain: 0; color-grading: 1; saturation: 0.06; contrast: 0.05; brightness: 0.015; height-fog: 1; fog-color: 0xd0d6d8; fog-density: 0.0025; fog-height: 96; fog-falloff: 0.10"
        >
        </GameObject>

        <!-- Adaptive Quality: target 60; max 1.0 = resolução nativa na dGPU.
             Em iGPU/PRIME mal configurado o piso 0.55 ainda protege FPS. -->
        <AdaptiveQuality
          target-fps="60"
          min-pixel-ratio="0.55"
          max-pixel-ratio="1.0"
        ></AdaptiveQuality>

        <!-- Mixer buses + BGM layers. O MusicLayerDriverSystem (engine)
           crossfada explore/battle conforme aggro; ambas saem na bus 'music'
           controlada pelo slider de volume. -->
        <AudioMixer master="1" music="0.7" sfx="0.8"></AudioMixer>
        <MusicLayer layer="explore" sound="bgm-explore" base-volume="0.18"></MusicLayer>
        <MusicLayer layer="battle" sound="bgm-battle" base-volume="0.22"></MusicLayer>

        <!-- Clima global: vento constante de SW, nuvens com ciclo lento
           (cobertura "respira" ao longo de minutos), chuva controlada por
           bioma (pântano) ou via setWeather() em runtime. -->
        <Weather
          wind="0.7 0.25"
          wind-strength="1.5"
          clouds="0.5"
          cloud-height="150"
          rain="0"
          cycle="1"
        ></Weather>

        <!-- ============================================================
           §1 BIOMAS — 4 cunhas cardeais. O BiomeDetectionSystem aplica
           tint/fog/ambient/textura-de-terreno e crossfade de BGM quando
           o herói entra. type: 1=FLORESTA, 2=DESERTO, 3=PÂNTANO,
           4=MONTANHA. As cunhas começam fora do quadrado central (±28)
           e são partidas pelas diagonais (±520 nos cantos) — sem
           sobreposição; a cidade fica como vale neutro. Os cantos foram
           de ±240 para ±520 porque a câmera passou a ver até 420 m: com
           ±240 a serra da borda ficava fora de qualquer bioma e perdia
           tint/fog.
           ============================================================ -->
        <!-- NORTE: Floresta Sombria -->
        <BiomeRegion
          id="dark-forest"
          type="1"
          polygon="[-56,56;56,56;1040,1040;-1040,1040]"
          tint="#1a3320"
          fog-color="#16241c"
          fog-density="0.0038"
          ambient="#3a4a55"
          bgm-layer="1"
          clouds="0.85"
          pp-exposure="0.8"
          pp-vignette-darkness="0.55"
          terrain-texture="/assets/textures/forest_floor.png"
        ></BiomeRegion>
        <!-- LESTE: Deserto -->
        <BiomeRegion
          id="desert"
          type="2"
          polygon="[56,-56;56,56;1040,1040;1040,-1040]"
          tint="#c2a878"
          fog-color="#d8c89a"
          fog-density="0.0019"
          ambient="#5a4a3a"
          bgm-layer="1"
          clouds="0.25"
          pp-exposure="1.12"
          pp-bloom-strength="0.20"
          terrain-texture="/assets/textures/desert_sand.png"
        ></BiomeRegion>
        <!-- SUL: Pântano -->
        <BiomeRegion
          id="swamp"
          type="3"
          polygon="[-56,-56;56,-56;1040,-1040;-1040,-1040]"
          tint="#3a4a30"
          fog-color="#16241a"
          fog-density="0.0050"
          ambient="#2a3a30"
          bgm-layer="1"
          rain="0.35"
          pp-exposure="0.9"
          terrain-texture="/assets/textures/swamp_mud.png"
        ></BiomeRegion>
        <!-- OESTE: Picos Gelados -->
        <BiomeRegion
          id="frozen-peaks"
          type="4"
          polygon="[-56,-56;-56,56;-1040,1040;-1040,-1040]"
          tint="#cdd9e6"
          fog-color="#dfe8f2"
          fog-density="0.0016"
          ambient="#aeb9c8"
          bgm-layer="1"
          pp-exposure="1.05"
          terrain-texture="/assets/textures/snow_peak.png"
        ></BiomeRegion>
      </Group>
      <!-- FIM environment -->
