<!--
  World fragment loaded via Include src= (see index.html shell).
  Edit this file — do not paste into index.html.
  Cell coords for CityGrid: space-separated (at="2 1").
-->
      <Group name="environment" pos="0 0 0">
        <!-- ============================================================
           §0 CÉU, LUZ, PÓS-PROCESSAMENTO E ÁUDIO
           Pipeline moderado (stylized): sombras PCSS 1024, SSAO + bloom +
           fog/grading. DoF / god-rays / film-grain OFF (custo alto, pouco
           ganho em jogabilidade). SSR OFF (águas usam mirror planar).
           AdaptiveQuality pode baixar DPR até 0.75 sob pressão.
           ============================================================ -->
        <EquirectSky
          url="/assets/sky/sky.png"
          environment-intensity="0.45"
          background-intensity="1.4"
        ></EquirectSky>

        <!-- Sol baixo + ambient. Shadow 1024 + PCSS lean; CA off; SSAO
           half via AdaptiveQuality. CSM OFF (CustomShaderMaterial).

           NEVOEIRO: fog-density era 0.024 com o far da câmera a 130 m —
           tudo além de ~150 m era leite, e a serra que agora fecha o
           horizonte não se veria. Com 0.008 (+ fog-height 96, acima das
           cristas de 90 m) o relevo distante lê-se como silhueta e a
           névoa continua a dar profundidade. As cunhas por baixo mantêm
           as suas densidades relativas — ver <BiomeRegion> abaixo. -->
        <GameObject
          ambient-light="sky-color: 0xfff8f0; ground-color: 0xe0d0a8; intensity: 0.85"
          directional-light="color: 0xfff0d0; intensity: 3.2; direction-x: -0.9; direction-y: 1.2; direction-z: -0.5; cast-shadow: 0; shadow-map-size: 512; distance: 80; pcss: 0"
          postprocessing="enabled: 1; bloom: 1; bloom-strength: 0.12; bloom-radius: 0.40; bloom-threshold: 0.92; chromatic-aberration: 0; vignette: 1; vignette-offset: 0.34; vignette-darkness: 0.40; aa: fxaa; tone-mapping: agx; tone-mapping-exposure: 1.10; ssao: 0; ssao-intensity: 0.55; ssao-radius: 1.0; depth-of-field: 0; god-rays: 0; film-grain: 0; color-grading: 1; saturation: 0.06; contrast: 0.05; brightness: 0.015; height-fog: 1; fog-color: 0xc8d0d8; fog-density: 0.008; fog-height: 96; fog-falloff: 0.10"
        >
        </GameObject>

        <!-- Adaptive Quality: target 60; narrow DPR band to avoid tier flap. -->
        <AdaptiveQuality
          target-fps="60"
          min-pixel-ratio="0.55"
          max-pixel-ratio="0.75"
        ></AdaptiveQuality>

        <!-- Mixer buses only. BGM is owned by BgmSystem (playSound bgm-*) so
           MusicLayer entities do not double-play explore/battle tracks. -->
        <AudioMixer master="1" music="0.7" sfx="0.8"></AudioMixer>

        <!-- Clima global: vento constante de SW, nuvens com ciclo lento
           (cobertura "respira" ao longo de minutos), chuva controlada por
           bioma (pântano) ou via setWeather() em runtime. -->
        <Weather
          wind="0.7 0.25"
          wind-strength="1.5"
          clouds="0.5"
          cloud-height="150"
          rain="0"
          cycle="1"
        ></Weather>

        <!-- ============================================================
           §1 BIOMAS — 4 cunhas cardeais. O BiomeDetectionSystem aplica
           tint/fog/ambient/textura-de-terreno e crossfade de BGM quando
           o herói entra. type: 1=FLORESTA, 2=DESERTO, 3=PÂNTANO,
           4=MONTANHA. As cunhas começam fora do quadrado central (±28)
           e são partidas pelas diagonais (±520 nos cantos) — sem
           sobreposição; a cidade fica como vale neutro. Os cantos foram
           de ±240 para ±520 porque a câmera passou a ver até 420 m: com
           ±240 a serra da borda ficava fora de qualquer bioma e perdia
           tint/fog.
           ============================================================ -->
        <!-- NORTE: Floresta Sombria -->
        <BiomeRegion
          id="dark-forest"
          type="1"
          polygon="[-28,28;28,28;520,520;-520,520]"
          tint="#1a3320"
          fog-color="#16241c"
          fog-density="0.012"
          ambient="#3a4a55"
          bgm-layer="1"
          clouds="0.85"
          pp-exposure="0.8"
          pp-vignette-darkness="0.55"
          terrain-texture="/assets/textures/forest_floor.png"
        ></BiomeRegion>
        <!-- LESTE: Deserto -->
        <BiomeRegion
          id="desert"
          type="2"
          polygon="[28,-28;28,28;520,520;520,-520]"
          tint="#c2a878"
          fog-color="#d8c89a"
          fog-density="0.006"
          ambient="#5a4a3a"
          bgm-layer="1"
          clouds="0.25"
          pp-exposure="1.12"
          pp-bloom-strength="0.20"
          terrain-texture="/assets/textures/desert_sand.png"
        ></BiomeRegion>
        <!-- SUL: Pântano -->
        <BiomeRegion
          id="swamp"
          type="3"
          polygon="[-28,-28;28,-28;520,-520;-520,-520]"
          tint="#3a4a30"
          fog-color="#16241a"
          fog-density="0.016"
          ambient="#2a3a30"
          bgm-layer="1"
          rain="0.35"
          pp-exposure="0.9"
          terrain-texture="/assets/textures/swamp_mud.png"
        ></BiomeRegion>
        <!-- OESTE: Picos Gelados -->
        <BiomeRegion
          id="frozen-peaks"
          type="4"
          polygon="[-28,-28;-28,28;-520,520;-520,-520]"
          tint="#cdd9e6"
          fog-color="#dfe8f2"
          fog-density="0.005"
          ambient="#aeb9c8"
          bgm-layer="1"
          pp-exposure="1.05"
          terrain-texture="/assets/textures/snow_peak.png"
        ></BiomeRegion>
      </Group>
      <!-- FIM environment -->
