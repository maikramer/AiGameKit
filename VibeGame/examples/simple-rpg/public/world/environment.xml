<!--
  World fragment loaded via Include src= (see index.html shell).
  Edit this file — do not paste into index.html.
  Cell coords for CityGrid: space-separated (at="4 2").
-->
      <Group name="environment" pos="0 0 0">
        <!-- ============================================================
           §0 CÉU, LUZ, PÓS-PROCESSAMENTO E ÁUDIO
           Pipeline moderado (stylized): sombras PCSS 1024, SSAO + bloom +
           fog/grading. DoF / god-rays / film-grain OFF (custo alto, pouco
           ganho em jogabilidade). SSR OFF (águas usam mirror planar).
           AdaptiveQuality pode baixar DPR até 0.55 sob pressão; teto 1.0
           (nativo) quando a dGPU está no jogo.
           ============================================================ -->
        <!-- Céu atmosférico procedural (espalhamento de Preetham + nuvens no
             shader + disco solar): o sol definido aqui dirige a direcional
             abaixo e o PMREM vira `scene.environment` — céu, sombras e o
             ambient PBR compartilham um único sol. O equirect painterly
             (sky.png) fica disponível em /assets/sky/ para quem preferir
             céu de imagem (`<EquirectSky>`). Nuvens do shader ficam leves
             porque os billboards do Weather (crossfade por bioma) são a
             camada de nuvens "de jogo". -->
        <Sky
          sun-elevation="26"
          sun-azimuth="205"
          turbidity="2.8"
          rayleigh="1.7"
          mie-coefficient="0.004"
          mie-directional-g="0.85"
          cloud-coverage="0.15"
          cloud-density="0.25"
          cloud-elevation="0.55"
          environment-intensity="0.26"
          sun-intensity="5.0"
          drive-light="1"
        ></Sky>

        <!-- Ambiente hemisférico baixo: o IBL do céu é quem colore a sombra
           (azul de céu em cima, quente do chão embaixo); biomas continuam a
           crossfadar o ambient por região. Sombras 2048 + PCSS (penumbra que
           abre com a distância ao bloqueador). Height fog com perspectiva
           aérea + inscattering do sol; as densidades por bioma abaixo
           continuam a aplicar-se (o efeito lê o componente a cada frame).
           ACES dá o contraste que o AgX lavava; bloom só no sol/glare
           (threshold 8 — o céu procedural é HDR). -->
        <GameObject
          ambient-light="sky-color: 0xc8d8e8; ground-color: 0xa89878; intensity: 0.22"
          directional-light="cast-shadow: 1; shadow-map-size: 2048; distance: 100; pcss: 1"
          postprocessing="enabled: 1; bloom: 1; bloom-strength: 0.15; bloom-radius: 0.55; bloom-threshold: 8.0; chromatic-aberration: 0; vignette: 1; vignette-offset: 0.32; vignette-darkness: 0.36; aa: smaa; tone-mapping: aces; tone-mapping-exposure: 0.95; ssao: 1; ssao-intensity: 1.3; ssao-radius: 2.0; depth-of-field: 0; god-rays: 0; film-grain: 0; color-grading: 1; saturation: 0.12; contrast: 0.08; brightness: 0.0; height-fog: 1; fog-color: 0xd8d0c2; fog-density: 0.0018; fog-height: 132; fog-falloff: 35; fog-noise: 0.3; fog-sun-influence: 1.2; fog-sky-haze: 0.35"
        >
        </GameObject>

        <!-- Adaptive Quality: target 60; max 1.0 = resolução nativa na dGPU.
             Em iGPU/PRIME mal configurado o piso 0.55 ainda protege FPS. -->
        <AdaptiveQuality
          target-fps="60"
          min-pixel-ratio="0.55"
          max-pixel-ratio="1.0"
        ></AdaptiveQuality>

        <!-- Fronteira suave, perto do fim do mapa (terreno ±2000): a serra
             fecha o horizonte na crista (~560) e o lado de lá desce até à
             orla. Cruzar r=1800 conta 5 s no ecrã e devolve o herói ao ponto
             mais próximo DENTRO da fronteira, assente no chão e sem
             velocidade — em vez de cair do mundo no corte final. -->
        <WorldBorder
          radius="1800"
          warn-seconds="5"
          margin="80"
        ></WorldBorder>

        <!-- Mixer buses + BGM layers. O MusicLayerDriverSystem (engine)
           crossfada explore/battle conforme aggro; ambas saem na bus 'music'
           controlada pelo slider de volume. -->
        <AudioMixer master="1" music="0.7" sfx="0.8"></AudioMixer>
        <MusicLayer layer="explore" sound="bgm-explore" base-volume="0.18"></MusicLayer>
        <MusicLayer layer="battle" sound="bgm-battle" base-volume="0.22"></MusicLayer>

        <!-- Clima global: vento constante de SW, nuvens com ciclo lento
           (cobertura "respira" ao longo de minutos), chuva controlada por
           bioma (pântano) ou via setWeather() em runtime. -->
        <Weather
          wind="0.7 0.25"
          wind-strength="1.5"
          clouds="0.25"
          cloud-height="150"
          rain="0"
          cycle="1"
        ></Weather>

        <!-- ============================================================
           §1 BIOMAS — 4 cunhas cardeais. O BiomeDetectionSystem aplica
           tint/fog/ambient/textura-de-terreno e crossfade de BGM quando
           o herói entra. type: 1=FLORESTA, 2=DESERTO, 3=PÂNTANO,
           4=MONTANHA. As cunhas começam fora do quadrado central (±28)
           e são partidas pelas diagonais (±520 nos cantos) — sem
           sobreposição; a cidade fica como vale neutro. Os cantos foram
           de ±240 para ±520 porque a câmera passou a ver até 420 m: com
           ±240 a serra da borda ficava fora de qualquer bioma e perdia
           tint/fog.
           ============================================================ -->
        <!-- NORTE: Floresta Sombria -->
        <BiomeRegion
          id="dark-forest"
          type="1"
          polygon="[-56,56;56,56;1040,1040;-1040,1040]"
          tint="#1a3320"
          fog-color="#16241c"
          fog-density="0.0038"
          ambient="#3a4a55"
          bgm-layer="1"
          clouds="0.85"
          pp-exposure="0.8"
          pp-vignette-darkness="0.55"
          terrain-texture="/assets/textures/forest_floor.png"
        ></BiomeRegion>
        <!-- LESTE: Deserto -->
        <BiomeRegion
          id="desert"
          type="2"
          polygon="[56,-56;56,56;1040,1040;1040,-1040]"
          tint="#c2a878"
          fog-color="#d8c89a"
          fog-density="0.0019"
          ambient="#5a4a3a"
          bgm-layer="1"
          clouds="0.25"
          pp-exposure="1.12"
          pp-bloom-strength="0.20"
          terrain-texture="/assets/textures/desert_sand.png"
        ></BiomeRegion>
        <!-- OESTE: Pântano (bacias baixas do relevo real) -->
        <BiomeRegion
          id="swamp"
          type="3"
          polygon="[-56,-56;-56,56;-1040,1040;-1040,-1040]"
          tint="#3a4a30"
          fog-color="#16241a"
          fog-density="0.0050"
          ambient="#2a3a30"
          bgm-layer="1"
          rain="0.35"
          pp-exposure="0.9"
          terrain-texture="/assets/textures/swamp_mud.png"
        ></BiomeRegion>
        <!-- SUL: Picos Gelados. Vértice da cunha empurrado de ±56 para ±240:
             o setor sul só ganha cota a partir de r≈260 (126 m a 80-160 m,
             161 m a 400-600 m). Com o vértice na muralha, a textura de neve
             começava a 60 m do portão, em pleno fundo de vale. Entre a
             cidade e r=240 fica o anel neutro do vale. -->
        <BiomeRegion
          id="frozen-peaks"
          type="4"
          polygon="[-240,-240;240,-240;1040,-1040;-1040,-1040]"
          tint="#cdd9e6"
          fog-color="#dfe8f2"
          fog-density="0.0016"
          ambient="#aeb9c8"
          bgm-layer="1"
          pp-exposure="1.05"
          terrain-texture="/assets/textures/snow_peak.png"
        ></BiomeRegion>
      </Group>
      <!-- FIM environment -->
