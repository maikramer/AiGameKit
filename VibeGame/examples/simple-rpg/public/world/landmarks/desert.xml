<!--
  Landmarks do DESERTO (Leste). Loaded via Include.
  Arco (§1, sandstone_arch) e obelisco solar (§3, desert_obelisk) migrados
  de <Composition> de primitivas para GLB real (lod0-2 + collision) —
  confirmado em public/world/ASSETS_REGISTRY.md. form_arch_3 (rocks3d,
  arco natural mais pequeno, ~3.2×2.2×1.6 m) não substitui nenhum dos
  dois: sandstone_arch/desert_obelisk já são os assets dedicados a este
  landmark. cactus, scorpion_nest e ruin_pillar já vinham GLTFLoader.
-->
<Group name="biome.desert.landmarks" pos="0 0 0">
  <!-- ============================================================
       §1 ARCO MONUMENTAL (95, 32)
       Portal de arenito de ~10 m (sandstone_arch, GLB real) — o marco
       que se vê da estrada leste e diz "há alguma coisa lá à frente".
       ============================================================ -->
  <!-- ⚠️ `sandstone_arch_collision.glb` NÃO serve de collider: é um casco
       decimado que preenche 82 % da bbox — o portal estava tapado de y=0 a
       y=10 e não se passava por baixo. O mesh visual tem os pilares em
       x ≈ ±2.85 (largura 1.34) e o vão livre em x ∈ [-2.18, 2.18] (4.36 m).
       Colisão = duas caixas-pilar, rodadas com o arco. -->
  <GameObject
    name="desert-arch"
    place="at: 190 64; align-to-terrain: 0"
    transform="rotation: 0 35 0"
  >
    <GLTFLoader
      role="visual"
      url="/assets/meshes/desert/sandstone_arch_lod0.glb"
      lod1-url="/assets/meshes/desert/sandstone_arch_lod1.glb"
      lod2-url="/assets/meshes/desert/sandstone_arch_lod2.glb"
      lod-threshold-near="55"
      lod-threshold-mid="150"
    ></GLTFLoader>
  </GameObject>
  <!-- Pilares: local (±2.85, 0) rodado 35° → offset mundo (±2.34, ∓1.64). -->
  <GameObject
    name="desert-arch-pillar-a"
    place="at: 194.68 60.74; align-to-terrain: 0"
    transform="rotation: 0 35 0"
    rigidbody="type: fixed; mass: 0; gravity-scale: 0"
    collider="shape: box; size: 1.5 7.0 2.8; pos-offset-y: 3.5"
  ></GameObject>
  <GameObject
    name="desert-arch-pillar-b"
