    at="8 -95"
    radius="12"
    depth="2.6"
    water-offset="0.5"
    color="#2f5a4a"
    opacity="0.8"
    ripple="0.7"
  ></Lake>
  <Lake
    at="-34 -78"
    radius="7"
    depth="2.1"
    water-offset="0.5"
