<!--
  Rede cobble interligada (não só cruz +).
  - flatten-max-grade=0.34 (≈19°) e flatten-window=72: com o relevo cru do
    Terrain3D as artérias sobem encostas de 13-20° (o setor leste vai de 134 m
    no vale a 165 m). Com o antigo 0.22 (12.4°) o `limitProfileGrade` prendia
    o perfil abaixo do terreno e o carve tinha de abrir uma trincheira mais
    funda do que o falloff alcança — a estrada ficava numa vala de paredes
    verticais. Deixar a estrada seguir a encosta é mais barato e lê-se melhor.
  - Cruz praça → mid_* (grau 4) → portões / biomas
  - Anel periurbano mid_n→ne→mid_e→se→mid_s→sw→mid_w→nw→mid_n
    (T nos mid_* = cruzamentos programáticos)
  - Ponte do rio: Segment profile=bridge (n_bank↔n_resume, artéria norte).
    O rio segue a drenagem real do heightmap e cruza SÓ o norte, em z≈214
    (o traçado em spawn/ring.xml passa exactamente por "4 215"). As antigas
    pontes sul e oeste atravessavam chão seco e foram removidas.
  - via= nos Segments longos (docks de trails.xml)
-->
<Group name="paths.network" pos="0 0 0">
  <RoadNetwork
    default-profile="artery"
    default-width="4"
    crossing-flare="true"
    flatten="true"
    flatten-falloff="26"
    flatten-window="72"
    flatten-max-grade="0.34"
    texture-url="/assets/textures/cobblestone_road.png"
    normal-map-url="/assets/textures/pbr_cobblestone_road/cobblestone_road_normal.png"
    texture-scale="5"
  >
    <!-- Praça + docks do anel (muralha ±39.8 — layout compacto).
         mid_* ficam 8 m dentro da muralha, alinhados com os portões. -->
    <Way id="plaza" xz="0 0" width="4.8"></Way>
    <Way id="mid_n" xz="0 32"></Way>
    <Way id="mid_e" xz="32 0"></Way>
    <Way id="mid_s" xz="0 -32"></Way>
    <Way id="mid_w" xz="-32 0"></Way>

    <!-- Cantos do anel -->
    <Way id="ring_ne" xz="25 25"></Way>
    <Way id="ring_se" xz="25 -25"></Way>
    <Way id="ring_sw" xz="-25 -25"></Way>
    <Way id="ring_nw" xz="-25 25"></Way>

    <!-- Norte (floresta) — a ponte vive aqui: margens simétricas ao centro
         do rio (z≈214), tips fora do ribbon de água (198/230), span 32 m.
         O deck GLB centra na centreline do rio (river-crossing.ts). -->
    <Way id="n_gate" xz="-3 128"></Way>
    <Way id="n_bank" xz="2 198"></Way>
    <Way id="n_resume" xz="6 230"></Way>
    <Way id="n_end" xz="-8 286"></Way>
    <!-- Sul (picos gelados) — sem rio, artéria contínua -->
    <Way id="s_end" xz="-12 -286"></Way>
    <!-- Este (deserto) -->
    <Way id="gate_e" xz="124 2"></Way>
    <Way id="desert_end" xz="290 -4"></Way>
    <!-- Oeste (pântano) — sem rio, artéria contínua -->
    <Way id="w_end" xz="-292 12"></Way>

    <!-- Cruzamento praça → mid (grau 4 em cada mid com anel) -->
    <Segment a="plaza" b="mid_n" via="0 5 0 19" profile="plaza"></Segment>
    <Segment a="plaza" b="mid_s" via="0 -5 0 -19" profile="plaza"></Segment>
    <Segment a="plaza" b="mid_e" via="5 0 19 0" profile="plaza"></Segment>
    <Segment a="plaza" b="mid_w" via="-5 0 -19 0" profile="plaza"></Segment>

    <!-- Artérias além do anel -->
    <Segment a="mid_n" b="n_gate" via="0 60 -2 96"></Segment>
    <Segment a="n_gate" b="n_bank" via="0 152 2 176"></Segment>
    <Segment
      a="n_bank"
      b="n_resume"
      profile="bridge"
      bridge-native-span="18"
      bridge-url="/assets/meshes/infra/river_bridge_wood_lod0.glb"
      bridge-collision-url="/assets/meshes/infra/river_bridge_wood_collision.glb"
      bridge-lod1-url="/assets/meshes/infra/river_bridge_wood_lod1.glb"
      bridge-lod2-url="/assets/meshes/infra/river_bridge_wood_lod2.glb"
    ></Segment>
    <Segment a="n_resume" b="n_end" via="2 252 -4 270"></Segment>
    <Segment a="mid_s" b="s_end" via="0 -58 2 -84 0 -184 18 -220"></Segment>
    <Segment a="mid_e" b="gate_e" via="60 0 96 2"></Segment>
    <Segment a="gate_e" b="desert_end" via="160 6 200 10 240 8"></Segment>
    <Segment a="mid_w" b="w_end" via="-58 0 -80 -2 -208 2"></Segment>

    <!-- Anel periurbano (liga os quatro mid_*) -->
    <Segment a="mid_n" b="ring_ne" via="11 32 20 29"></Segment>
    <Segment a="ring_ne" b="mid_e" via="29 20 32 11"></Segment>
    <Segment a="mid_e" b="ring_se" via="32 -11 29 -20"></Segment>
    <Segment a="ring_se" b="mid_s" via="20 -29 11 -32"></Segment>
    <Segment a="mid_s" b="ring_sw" via="-11 -32 -20 -29"></Segment>
    <Segment a="ring_sw" b="mid_w" via="-29 -20 -32 -11"></Segment>
    <Segment a="mid_w" b="ring_nw" via="-32 11 -29 20"></Segment>
    <Segment a="ring_nw" b="mid_n" via="-20 29 -11 32"></Segment>
  </RoadNetwork>
</Group>
<!-- FIM paths.network -->
