<!--
  CityGrid showcase OUTSIDE the walled city (NE of murals ±32).
  Do NOT place near chapel (8,22) / plaza — WallRect would clip GLBs.
  Cell coords: space-separated (at="2 1").
-->
<Group name="city.grid-district" pos="0 0 0">
  <!-- World cells: origin 55 55, cell 4 → roughly x/z ∈ [55, 79] — clear of walls -->
  <CityGrid cell="4" origin="55 55" align-to-terrain="0" name="city.grid">
    <WallRect
      min="0 0"
      max="6 5"
      height="3.2"
      thickness="0.65"
      color="#7a7a74"
      texture-url="/assets/textures/mountain_stone.png"
      normal-map-url="/assets/textures/pbr_mountain_stone/mountain_stone_normal.png"
      texture-repeat="2 1"
      gates="s"
      gate-prefab="gate"
    ></WallRect>
    <StreetCross
      min="0 0"
      max="6 5"
      width="1"
      texture-url="/assets/textures/cobblestone_road.png"
    ></StreetCross>
    <Plaza
      min="2 2"
      max="4 3"
      color="#6b4a2b"
      texture-url="/assets/textures/cobblestone_road.png"
      name="city.grid.plaza"
    ></Plaza>
    <BuildingRow
      from="1 1"
      to="5 1"
      step="2"
      prefab="house"
      name="city.grid.n"
      rot="180"
    ></BuildingRow>
    <Building at="1 4" prefab="chapel" name="city.grid.chapel"></Building>
    <Building at="5 4" prefab="forge" name="city.grid.forge" rot="90"></Building>
    <Block
      min="5 2"
      max="5 3"
      mode="fill"
      prefab="cottage"
      name="city.grid.e"
    ></Block>
    <Prop at="3 2" prefab="well" name="city.grid.well"></Prop>
    <Prop at="3 3" prefab="campfire" collider="none" name="city.grid.fire"></Prop>
    <Prop at="2 3" prefab="torch" collider="none"></Prop>
    <Slot at="4 2" role="notice" name="city.grid.slot.notice"></Slot>
  </CityGrid>
</Group>
