            place="at: 9.5 -3.6; align-to-terrain: 0"
            rigidbody="type: fixed; mass: 0; gravity-scale: 0"
            collider="shape: box; size: 1.6 0.9 0.55"
          >
            <GLTFLoader
              role="visual"
              url="/assets/meshes/village/wooden_bench_lod0.glb"
            lod1-url="/assets/meshes/village/wooden_bench_lod1.glb"
            lod2-url="/assets/meshes/village/wooden_bench_lod2.glb"
            ></GLTFLoader>
          </GameObject>
          <!-- Quadro de avisos (borda sul da praça) — GLB notice_board.
               [F] abre as recompensas da guarda (src/scripts/notice-board.ts). -->
          <GameObject
            name="notice_board"
            place="at: 5 -12.5; align-to-terrain: 0"
            rigidbody="type: fixed; mass: 0; gravity-scale: 0"
            collider="shape: trimesh; mesh-url: /assets/meshes/village/notice_board_collision.glb; mesh-anchor: base"
