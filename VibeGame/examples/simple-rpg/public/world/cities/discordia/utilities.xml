<!-- utilities: praça essencial — poço, fogueira+luz, bancos GLB, quadro, tochas, santuários. -->
<Group name="city.plaza" pos="0 0 0">
          <!-- Poço medieval (~1.6 m nativo). Centro-oeste da praça. -->
          <GameObject
            name="well"
            place="at: -8 4; align-to-terrain: 0"
            rigidbody="type: fixed; mass: 0; gravity-scale: 0"
            collider="shape: trimesh; mesh-url: /assets/meshes/medieval_well_lod2.glb; mesh-anchor: base"
          >
            <GLTFLoader
              role="visual"
              url="/assets/meshes/medieval_well_lod0.glb"
            lod1-url="/assets/meshes/medieval_well_lod1.glb"
            lod2-url="/assets/meshes/medieval_well_lod2.glb"
            ></GLTFLoader>
          </GameObject>
          <!-- Fogueira comunitária: GLB campfire_pit (anel de pedra, sem
           chama modelada) + brasa/luz por cima. -->
          <GameObject
            name="campfire"
            place="at: 12 -10; align-to-terrain: 0"
            rigidbody="type: fixed; mass: 0; gravity-scale: 0"
            collider="shape: trimesh; mesh-url: /assets/meshes/campfire_pit_collision.glb; mesh-anchor: base"
          >
            <GLTFLoader
              role="visual"
              url="/assets/meshes/campfire_pit_lod0.glb"
              lod1-url="/assets/meshes/campfire_pit_lod1.glb"
              lod2-url="/assets/meshes/campfire_pit_lod2.glb"
            ></GLTFLoader>
          </GameObject>
          <!-- Chama: partículas reais, não um <Sphere> laranja. A esfera opaca
               estática que aqui estava lia-se como uma bola pousada na pedra.
               Geometria medida do campfire_pit: aro de pedra com topo a
               y≈0.30 e cavidade interior de raio ≈0.5 → chama enraizada a
               y=0.30 com raio de emissão 0.32 (fica dentro do aro). -->
          <GameObject place="at: 12 -10; align-to-terrain: 0">
            <ParticleSystem
              preset="fire"
              transform="pos: 0 0.30 0"
              particle-emitter="preset: fire; emission-rate: 48; shape-radius: 0.32; start-life-min: 0.5; start-life-max: 1.35; start-speed-min: 1.3; start-speed-max: 2.9; start-size-min: 0.34; start-size-max: 0.7; looping: 1; world-space: 1"
            ></ParticleSystem>
          </GameObject>
          <Composition
            place="at: 12 -10; align-to-terrain: 0"
            body="fixed"
            collider="none"
          >
            <PointLight
              pos="0 0.7 0"
              point-light="color: 0xff8a33; intensity: 3; distance: 10; decay: 2; cast-shadow: 0"
            ></PointLight>
          </Composition>
          <!-- Bancos de madeira virados para a fogueira (rotação em graus) -->
          <GameObject
            transform="rotation: 0 35 0"
            place="at: 8 -6; align-to-terrain: 0"
            rigidbody="type: fixed; mass: 0; gravity-scale: 0"
            collider="shape: box; size: 1.2 0.5 0.5"
          >
            <GLTFLoader
              role="visual"
              url="/assets/meshes/wooden_bench_lod0.glb"
            lod1-url="/assets/meshes/wooden_bench_lod1.glb"
            lod2-url="/assets/meshes/wooden_bench_lod2.glb"
            ></GLTFLoader>
          </GameObject>
          <GameObject
            transform="rotation: 0 -35 0"
            place="at: 16 -6; align-to-terrain: 0"
            rigidbody="type: fixed; mass: 0; gravity-scale: 0"
            collider="shape: box; size: 1.2 0.5 0.5"
          >
            <GLTFLoader
              role="visual"
              url="/assets/meshes/wooden_bench_lod0.glb"
            lod1-url="/assets/meshes/wooden_bench_lod1.glb"
            lod2-url="/assets/meshes/wooden_bench_lod2.glb"
            ></GLTFLoader>
          </GameObject>
          <!-- Quadro de avisos (borda sul da praça) — GLB notice_board. -->
          <GameObject
            name="notice_board"
            place="at: 8 -20; align-to-terrain: 0"
            rigidbody="type: fixed; mass: 0; gravity-scale: 0"
            collider="shape: trimesh; mesh-url: /assets/meshes/notice_board_collision.glb; mesh-anchor: base"
          >
            <GLTFLoader
              role="visual"
              url="/assets/meshes/notice_board_lod0.glb"
              lod1-url="/assets/meshes/notice_board_lod1.glb"
              lod2-url="/assets/meshes/notice_board_lod2.glb"
            ></GLTFLoader>
          </GameObject>
          <!-- Tochas da praça: GLB torch_post (sem chama modelada) + brasa/luz
           por cima — orçamento de PointLights mantido em 2. -->
          <GameObject
            place="at: 14 14; align-to-terrain: 0"
            rigidbody="type: fixed; mass: 0; gravity-scale: 0"
            collider="shape: trimesh; mesh-url: /assets/meshes/torch_post_collision.glb; mesh-anchor: base"
          >
            <GLTFLoader
              role="visual"
              url="/assets/meshes/torch_post_lod0.glb"
              lod1-url="/assets/meshes/torch_post_lod1.glb"
              lod2-url="/assets/meshes/torch_post_lod2.glb"
            ></GLTFLoader>
          </GameObject>
          <!-- Chama da tocha: torch_post mede 2.20 m e a haste é sólida até
               y≈2.15, por isso a esfera a y=1.9 estava enterrada dentro do
               poste. Chama a y=2.14, estreita (raio 0.06) para caber na haste
               de 0.23 m. -->
          <GameObject place="at: 14 14; align-to-terrain: 0">
            <ParticleSystem
              preset="fire"
              transform="pos: 0 2.14 0"
              particle-emitter="preset: fire; emission-rate: 22; shape-radius: 0.06; start-life-min: 0.3; start-life-max: 0.8; start-speed-min: 0.9; start-speed-max: 1.9; start-size-min: 0.16; start-size-max: 0.34; looping: 1; world-space: 1"
            ></ParticleSystem>
          </GameObject>
          <Composition
            place="at: 14 14; align-to-terrain: 0"
            body="fixed"
            collider="none"
          >
            <PointLight
              pos="0 2.2 0"
              point-light="color: 0xffa83a; intensity: 1.6; distance: 7; decay: 2"
            ></PointLight>
          </Composition>
          <GameObject
            place="at: -14 -14; align-to-terrain: 0"
            rigidbody="type: fixed; mass: 0; gravity-scale: 0"
            collider="shape: trimesh; mesh-url: /assets/meshes/torch_post_collision.glb; mesh-anchor: base"
          >
            <GLTFLoader
              role="visual"
              url="/assets/meshes/torch_post_lod0.glb"
              lod1-url="/assets/meshes/torch_post_lod1.glb"
              lod2-url="/assets/meshes/torch_post_lod2.glb"
            ></GLTFLoader>
          </GameObject>
          <GameObject place="at: -14 -14; align-to-terrain: 0">
            <ParticleSystem
              preset="fire"
              transform="pos: 0 2.14 0"
              particle-emitter="preset: fire; emission-rate: 22; shape-radius: 0.06; start-life-min: 0.3; start-life-max: 0.8; start-speed-min: 0.9; start-speed-max: 1.9; start-size-min: 0.16; start-size-max: 0.34; looping: 1; world-space: 1"
            ></ParticleSystem>
          </GameObject>
          <Composition
            place="at: -14 -14; align-to-terrain: 0"
            body="fixed"
            collider="none"
          >
            <PointLight
