    max-distance="150"
    scale-axis-min="0.9"
    scale-axis-max="1.1"
    random-yaw="true"
    variation="tree"
  >
    <GameObject
      role="static"
      destructible="popup-text: Cactus; popup-color: #6a9a3a; preset: dust; hits: 2; spark-on-hit: 1; hit-preset: leaves; hit-burst-count: 14; shake-on-hit: 1; crack-on-hit: 1; crack-style: vertical; break-style: fall; cut-height: 0.4"
      script="tree.ts"
      rigidbody="type: fixed; mass: 0; gravity-scale: 0"
      collider="shape: trimesh; mesh-url: /assets/meshes/cactus_stump_collision.glb; mesh-anchor: base"
    >
      <GLTFLoader
        role="visual"
        url="/assets/meshes/cactus_lod0.glb"
        lod1-url="/assets/meshes/cactus_lod1.glb"
        lod2-url="/assets/meshes/cactus_lod2.glb"
        lod-threshold-near="36"
        lod-threshold-mid="110"
      ></GLTFLoader>
      <ResourceNode
        kind="wood"
        yield="2"
        transform="pos: 0 0 0"
      ></ResourceNode>
    </GameObject>
  </StaticSpawner>

  <!-- §3 Arbustos secos rolando pela areia — muitos, baratos, dão escala. -->
