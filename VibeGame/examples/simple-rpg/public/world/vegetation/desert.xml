<!--
  Vegetação do DESERTO (Leste, x ≳ 58). Loaded via Include.
  Mesh próprio do bioma: cactus (o dead_bush passa a ser arbusto seco, não
  "cacto"), a par do collider cactus_stump_collision que já era o pretendido.
  Densidade alta só em spawners scenery — ver nota em vegetation/forest.xml.
-->
<Group name="biome.desert.vegetation" pos="0 0 0">
  <!-- Tapete seco: erva rala e poucas flores. -->
  <Vegetation
    meshes="/assets/meshes/vegetation/grass.glb /assets/meshes/vegetation/grass_leafs.glb /assets/meshes/vegetation/plant_flatShort.glb /assets/meshes/vegetation/flower_yellowA.glb"
    density-per-km2="22000"
    seed="702"
    region-min="58 0 -95"
    region-max="185 0 95"
    scale-min="1.4"
    scale-max="2.8"
    max-slope-deg="32"
    avoid-water="1"
    avoid-overlaps="0"
    max-distance="110"
    cluster-count="34"
    cluster-radius="2.8"
    flower-near-radius="1.8"
    flower-density-ratio="0.16"
    plant-density-ratio="0.28"
    smart="1"
    wind="1"
    scale-axis-min="0.9"
    scale-axis-max="1.1"
    random-yaw="true"
    variation="foliage"
  ></Vegetation>

  <!-- §1 Cactos — a assinatura do bioma. Em grupos, como cresce a saguaro. -->
  <StaticSpawner
    profile="tree"
    count="140"
    seed="7101"
    region-min="60 0 -92"
    region-max="200 0 92"
    align-to-terrain="1"
    ground-align="auto"
    avoid-water="1"
    max-slope-deg="34"
    scale-min="0.8"
    scale-max="1.7"
    avoid-overlaps="1"
    footprint-radius="1.1"
    cluster-count="24"
    cluster-radius="14"
    max-distance="220"
    scale-axis-min="0.9"
    scale-axis-max="1.1"
    random-yaw="true"
    variation="tree"
  >
    <GameObject role="static">
      <GLTFLoader
        role="visual"
        url="/assets/meshes/cactus_lod0.glb"
        lod1-url="/assets/meshes/cactus_lod1.glb"
        lod2-url="/assets/meshes/cactus_lod2.glb"
        lod-threshold-near="30"
        lod-threshold-mid="85"
      ></GLTFLoader>
    </GameObject>
  </StaticSpawner>

  <!-- §2 Cactos colhíveis (collider + ResourceNode). -->
  <StaticSpawner
    profile="tree"
    count="18"
    seed="302"
    region-min="62 0 -60"
    region-max="150 0 60"
    align-to-terrain="1"
    ground-align="auto"
    avoid-water="1"
    max-slope-deg="30"
