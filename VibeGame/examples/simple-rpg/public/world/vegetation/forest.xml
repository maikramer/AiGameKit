<!--
  Vegetação da FLORESTA SOMBRIA (Norte, z ≳ 58). Loaded via Include.

  Regra de custo: um spawner "scenery" (só <GLTFLoader>) é instanciado — um
  draw call por URL — e aguenta centenas de instâncias. Um spawner
  "harvestable" traz collider trimesh + script + <ResourceNode> por instância
  e alimenta o bake do NavMesh, por isso fica na ordem das dezenas.
  Ver VibeGame/src/plugins/spawner/context.md.
-->
<Group name="biome.forest.vegetation" pos="0 0 0">
  <!-- Tapete: erva → plantas → flores sob o dossel (hubs partilhados). -->
  <Vegetation
    meshes="/assets/meshes/vegetation/grass_large.glb /assets/meshes/vegetation/grass_leafsLarge.glb /assets/meshes/vegetation/grass.glb /assets/meshes/vegetation/grass_leafs.glb /assets/meshes/vegetation/plant_flatTall.glb /assets/meshes/vegetation/plant_flatShort.glb /assets/meshes/vegetation/flower_purpleA.glb /assets/meshes/vegetation/flower_redA.glb /assets/meshes/vegetation/flower_yellowA.glb"
    density-per-km2="38000"
    seed="601"
    region-min="-95 0 58"
    region-max="95 0 190"
    scale-min="1.4"
    scale-max="2.8"
    max-slope-deg="38"
    avoid-water="1"
    avoid-overlaps="0"
    max-distance="110"
    cluster-count="64"
    cluster-radius="4.4"
    flower-near-radius="2.4"
