    seed="907"
    region-min="-370 0 -190"
    region-max="-116 0 190"
    scale-min="1.4"
    scale-max="2.8"
    max-slope-deg="34"
    avoid-water="1"
    avoid-overlaps="0"
    max-distance="110"
    cluster-count="28"
    cluster-radius="6"
    flower-near-radius="4"
