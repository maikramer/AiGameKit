    region-min="46 0 -240"
    region-max="240 0 -24"
    scale-min="1.0"
    scale-max="1.9"
    max-slope-deg="34"
    avoid-water="1"
    avoid-road="1"
    avoid-overlaps="0"
    max-distance="100"
    cluster-count="70"
