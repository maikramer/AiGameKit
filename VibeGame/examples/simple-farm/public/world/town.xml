<!--
  World fragment loaded via Include src= (see index.html shell).
  Edit this file — do not paste into index.html.

  A small town on the central pad, ~70 m across inside a 96 m floor. Buildings
  ring a square at the origin so all four arteries arrive at something.

  CONTRACT — src/ resolves these two by name:
    name="farm_home"    → sleep.ts (bed prompt, 4.5 m)
    name="farm_market"  → shop.ts  (buy seeds / sell produce, 4 m)
  Renaming either silently breaks the interaction.

  Buildings use collider="shape: precompute" (read from gameassets_handoff.json)
  rather than a *_collision.glb fetch — same reason as the trees: it keeps the
  instanced render path while still giving Rapier a solid.
-->
<Group name="town" pos="0 0 0">
  <!-- Keeps vegetation and rocks out of the streets. Radius covers the pad
       core plus its falloff ring. -->
  <SpawnExclusion at="0 0" radius="56"></SpawnExclusion>

  <!-- ════════════════════ Gameplay anchors ════════════════════ -->

  <GameObject
    name="farm_home"
    place="at: -14 12; align-to-terrain: 0"
    rot="0 145 0"
    rigidbody="type: fixed; mass: 0; gravity-scale: 0"
    collider="shape: precompute; mesh-url: /assets/meshes/village/shepherd_cottage_lod0.glb"
  >
    <GLTFLoader
      role="visual"
      url="/assets/meshes/village/shepherd_cottage_lod0.glb"
      lod1-url="/assets/meshes/village/shepherd_cottage_lod1.glb"
      lod2-url="/assets/meshes/village/shepherd_cottage_lod2.glb"
