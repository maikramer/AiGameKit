# =============================================================================
# Servidor de GPU do AiGameKit — vramd remoto (modo --listen).
#
# O container corre o supervisor + os workers de cada tool; o cliente (laptop)
# faz stage/put/generate/get/clean por TCP+token. Os modelos vivem no cache do
# vramd (volume /cache/models), não na imagem.
#
# Build (contexto = raiz do repo):
#   docker build -f scripts/docker/Dockerfile.server -t aigamekit-server .
# Deploy: scripts/docker/server-deploy.sh (sync-repo → build → up → token).
# =============================================================================
FROM nvidia/cuda:13.0.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/home/aikit
ENV PYTHONUNBUFFERED=1

# Python 3.13 vem do uv (instalado pelo bootstrap do install.sh); o python3 do
# apt só serve para arrancar o instalador. Node 22 é obrigatório para
# KTX2/meshopt (o apt do 24.04 traz 18). As libs X11/GL são para o wheel bpy
# headless; libmeshoptimizer evita o fallback npm no `text3d finish`.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-full \
    python3-pip \
    python3-venv \
    build-essential \
    unzip \
    pkg-config \
    git \
    curl \
    ca-certificates \
    libvulkan1 \
    mesa-vulkan-drivers \
    libmeshoptimizer-dev \
    libxfixes3 \
    libxi6 \
    libxrender1 \
    libxxf86vm1 \
    libxkbcommon0 \
    libxext6 \
    libsm6 \
    libice6 \
    libgl1 \
    libglx-mesa0 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# A base ubuntu:24.04 já traz `ubuntu` com UID 1000 (o cache do servidor é
# desse UID) — renomeia-se em vez de criar outra conta.
RUN usermod -l aikit -d /home/aikit -s /bin/bash ubuntu \
    && groupmod -n aikit ubuntu \
    && mkdir -p /home/aikit \
    && chown 1000:1000 /home/aikit

WORKDIR /opt/AiGameKit
# `.git` vem no contexto (o .dockerignore inclui-o de propósito): o vramd
# descobre a raiz do monorepo por `.git` + `Shared/` para achar os venvs.
COPY --chown=aikit:aikit . /opt/AiGameKit

USER aikit
# Shim de `nvidia-smi` SÓ para a instalação: sem GPU no build, o hook do
# clified instala torch CPU (e o torch CPU ignora CUDA_HOME, logo o nvdiffrast
# falha). Com Python 3.13 e "CUDA Version" visível, o hook instala o torch
# CUDA do PyPI (2.13+cu130). O shim é apagado no fim; em runtime o
# nvidia-container-toolkit monta o nvidia-smi real em /usr/bin.
RUN mkdir -p /home/aikit/fake-gpu \
    && printf '%s\n' '#!/bin/sh' \
        'echo "| NVIDIA-SMI 620.70.06  Driver Version: 620.70.06  CUDA Version: 13.0 |"' \
        > /home/aikit/fake-gpu/nvidia-smi \
    && chmod +x /home/aikit/fake-gpu/nvidia-smi

ENV PATH=/home/aikit/fake-gpu:/home/aikit/.local/bin:$PATH

# O cpp_extension do nvdiffrast (paint3d) exige CUDA_HOME; a imagem -devel tem
# o toolkit em /usr/local/cuda mas não exporta a variável.
ENV CUDA_HOME=/usr/local/cuda

# Perfil do servidor: só as tools que delegam no vramd. `rigging3d` fica no
# laptop (não fala com o vramd), `animator3d`/`materialize`/`gameassets` são
# CPU/orquestração local. Um RUN por tool: um retry não repete os anteriores.
# A cache do uv duplicaria os wheels CUDA (~3 GB/tool) na camada; limpa-se
# no fim de cada tool (o venv fica; o download repetido é barato nesta rede).
RUN AIGAMEKIT_PREFLIGHT=0 ./install.sh vramd && rm -rf /home/aikit/.cache/uv /home/aikit/.cache/pip
RUN AIGAMEKIT_PREFLIGHT=0 ./install.sh text2d && rm -rf /home/aikit/.cache/uv /home/aikit/.cache/pip
RUN AIGAMEKIT_PREFLIGHT=0 ./install.sh text3d && rm -rf /home/aikit/.cache/uv /home/aikit/.cache/pip
RUN AIGAMEKIT_PREFLIGHT=0 ./install.sh paint3d && rm -rf /home/aikit/.cache/uv /home/aikit/.cache/pip
RUN AIGAMEKIT_PREFLIGHT=0 ./install.sh text2sound && rm -rf /home/aikit/.cache/uv /home/aikit/.cache/pip
RUN AIGAMEKIT_PREFLIGHT=0 ./install.sh hi3d && rm -rf /home/aikit/.cache/uv /home/aikit/.cache/pip

# O shim não pode sombrear o nvidia-smi real do runtime.
RUN rm -rf /home/aikit/fake-gpu

# O modo remoto (--listen + sandbox) entrou no 0.6.0; falhar o build cedo é
# melhor do que descobrir no primeiro job.
RUN /opt/AiGameKit/Vramd/.venv/bin/python -c \
    "from vramd.remote import RemoteSandbox; import vramd; print('vramd', vramd.__version__)"

COPY --chown=aikit:aikit scripts/docker/server-entrypoint.sh /usr/local/bin/server-entrypoint
RUN chmod +x /usr/local/bin/server-entrypoint

# GPU + cache montado em /cache; o entrypoint só arranca o supervisor.
ENTRYPOINT ["/usr/local/bin/server-entrypoint"]
